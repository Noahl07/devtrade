{% import 'components/ui/_ui.html.twig' as ui %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#06080A">

    {# ── SEO ── #}
    <title>{% block title %}Développement fullstack et trading algorithmique{% endblock %} · dev.trade</title>
    <meta name="description" content="{% block meta_description %}{{ site_description }}{% endblock %}">
    <meta name="robots" content="{% block meta_robots %}index, follow{% endblock %}">
    <link rel="canonical" href="{% block canonical %}{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}{% endblock %}">

    {# ── Open Graph / réseaux sociaux ── #}
    <meta property="og:type" content="{% block og_type %}website{% endblock %}">
    <meta property="og:site_name" content="dev.trade">
    <meta property="og:title" content="{% block og_title %}{{ block('title') }} · dev.trade{% endblock %}">
    <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
    <meta property="og:url" content="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/og-default.png')) }}{% endblock %}">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="dev.trade : développement sur mesure et trading algorithmique">
    <meta name="twitter:card" content="summary_large_image">

    <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">

    {# ── Design system + layout (polices auto-hébergées, aucune ressource tierce) ── #}
    {# Préchargement des deux polices visibles dès le premier écran (évite un saut de mise en page) #}
    <link rel="preload" href="{{ asset('build/fonts/inter-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ asset('build/fonts/fraunces-normal.woff2') }}" as="font" type="font/woff2" crossorigin>
    {{ encore_entry_link_tags('site') }}

    {# Pages pas encore refondues (Phase 4) : ancien CSS, ramené aux tokens par legacy-bridge.css.
       Une page refondue vide ce bloc. TODO Phase 4 : supprimer ce bloc et Bootstrap Icons. #}
    {% block legacy_assets %}
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block stylesheets %}{% endblock %}
    {% block structured_data %}{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip-link" href="#contenu">Aller au contenu</a>

    {% include 'components/_header.html.twig' %}

    {% if app.flashes|length > 0 %}
        <div class="flash-stack" role="status">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash--{{ type }}">
                        <span>{{ message }}</span>
                        <button class="flash__close" type="button" data-flash-close aria-label="Fermer le message">{{ ui.icon('close') }}</button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}

    <main class="site-main main-content" id="contenu" tabindex="-1">
        {% block body %}{% endblock %}
    </main>

    {% include 'components/_footer.html.twig' %}

    {{ encore_entry_script_tags('site') }}
    {% block legacy_scripts %}
        {{ encore_entry_script_tags('custom-select') }}
    {% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
