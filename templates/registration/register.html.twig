{% extends 'security/_auth_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Créer un compte{% endblock %}

{% block auth_card %}
    <span class="eyebrow">Inscription</span>
    <h1>Créer un compte.</h1>
    <p>Gratuit. Il donne accès aux articles gratuits de la documentation.</p>

    {% if registrationForm.vars.errors|length %}
        <div class="form-alert">{{ ui.notice((registrationForm.vars.errors|first).message, 'risk') }}</div>
    {% endif %}

    {{ form_start(registrationForm, { attr: { class: 'auth-form', novalidate: 'novalidate' } }) }}
        <div class="auth-form__row">
            <div class="field">
                {{ form_label(registrationForm.firstName, null, { label_attr: { class: 'field__label' } }) }}
                {{ form_widget(registrationForm.firstName, { attr: { class: 'input', autocomplete: 'given-name' } }) }}
                {{ form_errors(registrationForm.firstName) }}
            </div>
            <div class="field">
                {{ form_label(registrationForm.lastName, null, { label_attr: { class: 'field__label' } }) }}
                {{ form_widget(registrationForm.lastName, { attr: { class: 'input', autocomplete: 'family-name' } }) }}
                {{ form_errors(registrationForm.lastName) }}
            </div>
        </div>

        <div class="field">
            {{ form_label(registrationForm.email, 'Adresse e-mail', { label_attr: { class: 'field__label' } }) }}
            {{ form_widget(registrationForm.email, { attr: { class: 'input', autocomplete: 'email' } }) }}
            {{ form_errors(registrationForm.email) }}
        </div>

        <div class="field">
            {{ form_label(registrationForm.plainPassword, null, { label_attr: { class: 'field__label' } }) }}
            <div class="password">
                {{ form_widget(registrationForm.plainPassword, { attr: { class: 'input' } }) }}
                <button class="password__toggle" type="button" data-password-toggle aria-pressed="false" aria-label="Afficher le mot de passe">{{ ui.icon('eye') }}</button>
            </div>
            <span class="field__help">Entre 8 et 128 caractères.</span>
            {{ form_errors(registrationForm.plainPassword) }}
        </div>

        <div class="field">
            <label class="checkbox">
                {{ form_widget(registrationForm.agreeTerms) }}
                <span>J'accepte les <a href="{{ path('app_cgu') }}" target="_blank">conditions d'utilisation</a> et j'ai lu la
                    <a href="{{ path('app_privacy') }}" target="_blank">politique de confidentialité</a>.</span>
            </label>
            {{ form_errors(registrationForm.agreeTerms) }}
        </div>

        <button type="submit" class="button button--primary auth-form__submit">Créer mon compte {{ ui.icon('arrow-right') }}</button>
    {{ form_end(registrationForm) }}

    <p class="auth__alt">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
{% endblock %}
