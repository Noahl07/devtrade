{# Une série de backtest avec son contexte obligatoire (PROMPT-REFONTE §2.2).
   Données : config/packages/shiro.yaml. Ne jamais afficher un chiffre sans ce contexte. #}
<article class="backtest" aria-labelledby="backtest-{{ backtest.id }}">
    <header class="backtest__head">
        <h3 class="backtest__title" id="backtest-{{ backtest.id }}">{{ backtest.title }}</h3>
        <span class="backtest__nature">Backtest : simulation, pas un résultat réel</span>
    </header>

    <dl class="backtest__context">
        <div><dt>Période</dt><dd>{{ backtest.period }}</dd></div>
        <div><dt>Trades</dt><dd class="num">{{ backtest.trades }}</dd></div>
        <div><dt>Risque</dt><dd>{{ backtest.risk }}</dd></div>
        <div><dt>Dépôt initial</dt><dd class="num">{{ backtest.deposit }}</dd></div>
        <div><dt>Source</dt><dd>{{ backtest.source }}</dd></div>
    </dl>

    <dl class="backtest__metrics">
        {% for metric in backtest.metrics %}
            <div class="backtest__metric">
                <dt>{{ metric.label }}</dt>
                <dd class="num">{{ metric.value }}</dd>
            </div>
        {% endfor %}
    </dl>
</article>
