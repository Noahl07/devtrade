{% extends 'base.html.twig' %}

{% block title %}{{ product_name }}, robot MT5{% endblock %}
{% block meta_description %}{{ product_name }} : robot MetaTrader 5 sur le fixing de Tokyo (USDJPY), en test sur compte démo. Résultats de backtest publiés avec leur contexte complet.{% endblock %}

{% block body %}

{# ══ HERO ══ #}
<section class="trading-hero">
    <div class="trading-hero__inner">
        <div class="trading-hero__badge">En test sur compte démo</div>
        <h1 class="trading-hero__title">
            {{ product_name }}<br>
            <em class="trading-hero__accent">le fixing de Tokyo, rien d'autre.</em>
        </h1>
        <p class="trading-hero__sub">
            Un robot MetaTrader 5 qui exploite le flux d'ordres du fixing de Tokyo sur {{ symbol }}.
        </p>

        <div class="trading-hero__disclaimer">
            <strong>Statut :</strong> en test sur compte démo depuis le {{ demo_since }}.
            Aucun historique réel vérifié à ce jour.
        </div>

        <div class="trading-hero__disclaimer">
            Le trading de CFD et de Forex comporte un risque élevé de perte en capital. Les performances passées, y compris en simulation, ne préjugent pas des performances futures. Ce site ne fournit ni conseil en investissement ni recommandation personnalisée.
        </div>
    </div>
</section>

<hr class="divider">

{# ══ PRINCIPE ══
   Volontairement général : les paramètres internes du robot ne sont pas publiés. #}
<section class="section">
    <span class="section-eyebrow">Le principe</span>
    <h2>Un seul mécanisme, bien délimité</h2>

    <div class="method-grid">
        <div class="method-card">
            <div class="method-card__num">01</div>
            <h3 class="method-card__title">Le fixing de Tokyo</h3>
            <p class="method-card__desc">
                Chaque jour ouvré, les banques japonaises fixent à 9h55 (heure de Tokyo) le cours
                de référence USD/JPY utilisé par de nombreuses entreprises pour leurs opérations de change.
            </p>
        </div>
        <div class="method-card">
            <div class="method-card__num">02</div>
            <h3 class="method-card__title">Les jours « gotobi »</h3>
            <p class="method-card__desc">
                Les 5, 10, 15, 20, 25 et 30 du mois (décalés au jour ouvré précédent si besoin),
                beaucoup d'entreprises japonaises règlent leurs échéances. Ce flux autour du fixing
                est étudié dans la littérature académique.
                {# TODO : références (Ito & Yamada 2017, Krohn/Mueller/Whelan 2024,
                   Bessho/Sugimoto/Suzuki 2023) non vérifiées, à vérifier avant publication. #}
            </p>
        </div>
        <div class="method-card">
            <div class="method-card__num">03</div>
            <h3 class="method-card__title">Une exposition courte</h3>
            <p class="method-card__desc">
                Le robot n'intervient que dans une fenêtre courte autour du fixing, ces jours-là.
                Chaque position a un stop de protection, aucune n'est gardée la nuit, et un
                coupe-circuit arrête le robot en cas de conditions anormales.
            </p>
        </div>
    </div>
</section>

<hr class="divider">

{# ══ RÉSULTATS DE BACKTEST ══ #}
<section class="section" id="resultats">
    <span class="section-eyebrow">Résultats de backtest</span>
    <h2>Des simulations, pas des résultats réels</h2>
    <p class="section-desc">
        Ces chiffres viennent du testeur de stratégie MetaTrader 5 sur des données historiques {{ symbol }}.
        Aucun historique réel vérifié n'existe à ce jour : le robot est en test sur compte démo depuis le {{ demo_since }}.
    </p>

    <div class="backtest-list">
        {% for backtest in backtests %}
            {% include 'trading/_backtest.html.twig' with { backtest: backtest } only %}
        {% endfor %}
    </div>

    <p class="backtest-costs"><strong>Non inclus :</strong> {{ costs_note }}</p>
</section>

<hr class="divider">

{# ══ RISQUES ET LIMITES ══ (aussi visible que les résultats, PROMPT-REFONTE §5.1.6) #}
<section class="section" id="limites">
    <span class="section-eyebrow">Risques et limites</span>
    <h2>Ce que ces chiffres ne disent pas</h2>
    <ul class="limits">
        <li><strong>Coûts réels.</strong> La commission du courtier n'est pas dans le testeur ; le spread et le glissement réels peuvent être plus élevés.</li>
        <li><strong>Exécution.</strong> Le résultat dépend d'une exécution à la seconde près : un serveur lent ou un courtier qui exécute mal le dégrade fortement.</li>
        <li><strong>Avantage variable.</strong> L'avantage mesuré était faible avant 2021 (environ +0,05 R par trade) ; rien ne garantit qu'il se maintienne.</li>
        <li><strong>Petit échantillon.</strong> Environ 65 trades par an : une année peut s'écarter fortement de la moyenne.</li>
        <li><strong>Un seul mécanisme.</strong> Si le flux autour du fixing change, l'avantage peut disparaître.</li>
        <li><strong>Démo en cours.</strong> Le test sur compte démo a commencé le {{ demo_since }} ; son résultat n'est pas encore analysé.</li>
    </ul>
</section>

<hr class="divider">

{# ══ WAITLIST ══ #}
<section class="section">
    <div class="waitlist-block" id="waitlist">
        <div class="waitlist-block__content">
            <span class="section-eyebrow">Accès anticipé</span>
            <h2 class="waitlist-block__title">Soyez notifié en premier.</h2>
            <p class="waitlist-block__desc">
                Inscrivez-vous pour être informé de la sortie de {{ product_name }}.
                Une seule notification, pas de newsletter.
            </p>

            <form class="waitlist-big-form" id="waitlistForm" onsubmit="submitWaitlist(event)">
                <div class="waitlist-big-form__row">
                    <input
                        type="text"
                        class="form-control"
                        placeholder="Prénom (optionnel)"
                        id="wl-firstname"
                        autocomplete="given-name"
                    >
                    <input
                        type="email"
                        class="form-control"
                        placeholder="votre@email.com"
                        id="wl-email"
                        required
                        autocomplete="email"
                    >
                    <button type="submit" class="btn btn--primary">
                        Rejoindre la waitlist
                    </button>
                </div>
                <p class="waitlist-note">Aucun spam — notification unique à la sortie de l'algo.</p>
            </form>

            <div id="waitlist-success" style="display:none;" class="waitlist-success">
                <span class="waitlist-success__icon">✓</span>
                <div>
                    <strong>Vous êtes sur la liste !</strong>
                    <p>On vous contacte dès que l'algo est disponible.</p>
                </div>
            </div>
        </div>

        <div class="waitlist-block__features">
            <div class="waitlist-feature">
                <span class="waitlist-feature__icon">{# Livraison clé en main → #}
                    <i class="bi bi-box-seam-fill"></i></span>
                <div>
                    <strong>Livraison clé en main</strong>
                    <p>Documentation complète + support à l'installation</p>
                </div>
            </div>
            <div class="waitlist-feature">
                <span class="waitlist-feature__icon">{# Rapport de backtest → #}
                <i class="bi bi-bar-chart-fill"></i></span>
                <div>
                    <strong>Rapport de backtest complet</strong>
                    <p>Toutes les métriques détaillées, trade par trade</p>
                </div>
            </div>
            <div class="waitlist-feature">
                <span class="waitlist-feature__icon">{# Licence personnelle → #}
                    <i class="bi bi-lock-fill"></i></span>
                <div>
                    <strong>Licence personnelle</strong>
                    <p>Usage exclusif, non redistribuable</p>
                </div>
            </div>
        </div>
    </div>
</section>

{% endblock %}

{% block stylesheets %}
<style>
/* Hero trading */
.trading-hero {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 6rem var(--section-px) 5rem;
}

.trading-hero__badge {
    display: inline-block;
    background: var(--color-accent-dim);
    color: var(--color-accent);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.35rem 1rem;
    border-radius: 100px;
    border: 0.5px solid var(--color-accent-border);
    margin-bottom: 2rem;
}

.trading-hero__title {
    margin-bottom: 1.5rem;
    max-width: 720px;
}
.trading-hero__accent { font-style: normal; color: var(--color-accent); }

.trading-hero__sub {
    max-width: 600px;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.75;
    margin-bottom: 3.5rem;
}

.trading-metrics {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5px;
    background: var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    max-width: 860px;
    margin-bottom: 1.5rem;
}

.trading-metric {
    background: var(--color-bg-2);
    padding: 1.8rem 2rem;
}

.trading-metric__val {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-accent);
    letter-spacing: -0.03em;
    line-height: 1;
    margin-bottom: 0.4rem;
}

.trading-metric__label {
    display: block;
    font-size: 13px;
    color: var(--color-text-muted);
    font-weight: 500;
    margin-bottom: 2px;
}

.trading-metric__note {
    display: block;
    font-size: 11px;
    color: var(--color-text-faint);
    font-weight: 300;
}

.trading-hero__disclaimer {
    font-size: 11.5px;
    color: var(--color-text-faint);
    font-style: italic;
    font-weight: 300;
}

/* Méthode grid */
.method-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

.method-card {
    background: var(--color-bg-2);
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color var(--transition);
}
.method-card:hover { border-color: var(--color-border-md); }

.method-card__num {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--color-accent);
    opacity: 0.3;
    line-height: 1;
    letter-spacing: -0.04em;
}

.method-card__title { color: #F0F2F7; }

.method-card__desc {
    font-size: 13.5px;
    line-height: 1.7;
    flex: 1;
}

.method-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

/* Waitlist block */
.waitlist-block {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 5rem;
    align-items: start;
    background: linear-gradient(135deg, rgba(62,180,137,0.05) 0%, transparent 70%);
    border: 0.5px solid rgba(62, 180, 137, 0.15);
    border-radius: var(--radius-xl);
    padding: 4rem;
}

.waitlist-block__title { margin-bottom: 1rem; }
.waitlist-block__desc { font-weight: 300; line-height: 1.7; margin-bottom: 2rem; }

.waitlist-big-form__row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
}

.waitlist-big-form__row .form-control { flex: 1; min-width: 180px; }

.waitlist-note {
    font-size: 12px;
    color: var(--color-text-faint);
    font-weight: 300;
}

.waitlist-success {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.2rem 1.5rem;
    background: var(--color-accent-dim);
    border: 0.5px solid var(--color-accent-border);
    border-radius: var(--radius-md);
}

.waitlist-success__icon {
    font-size: 1.2rem;
    color: var(--color-accent);
    line-height: 1.4;
}

.waitlist-success strong { color: var(--color-accent); display: block; margin-bottom: 2px; }
.waitlist-success p { font-size: 13px; color: var(--color-text-muted); }

.waitlist-block__features {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-top: 1rem;
}

.waitlist-feature {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
}

.waitlist-feature__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-dim);
    border: 0.5px solid var(--color-accent-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    flex-shrink: 0;
}

.waitlist-feature strong {
    display: block;
    font-size: 13.5px;
    color: #F0F2F7;
    margin-bottom: 2px;
}

.waitlist-feature p {
    font-size: 12.5px;
    color: var(--color-text-faint);
    font-weight: 300;
}

@media (max-width: 900px) {
    .trading-metrics { grid-template-columns: repeat(2, 1fr); }
    .method-grid { grid-template-columns: 1fr; }
    .waitlist-block { grid-template-columns: 1fr; gap: 2.5rem; padding: 2.5rem; }
}

@media (max-width: 600px) {
    .trading-metrics { grid-template-columns: repeat(2, 1fr); }
    .waitlist-big-form__row { flex-direction: column; }
}

/* Résultats de backtest */
.backtest-list { display: grid; gap: 1.5rem; margin-top: 2rem; }
.backtest {
    border: 1px solid var(--color-border-md);
    border-radius: var(--radius-lg);
    background: var(--color-bg-card);
    padding: 1.6rem;
}
.backtest__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.6rem; margin-bottom: 1.2rem; }
.backtest__title { font-size: 1.15rem; margin: 0; }
.backtest__nature { font-size: 12px; color: var(--color-gold); border: 1px solid var(--color-gold-dim); background: var(--color-gold-dim); border-radius: var(--radius-sm); padding: 0.2rem 0.6rem; }
.backtest__context { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 0.8rem 1.5rem; margin: 0 0 1.4rem; font-size: 14px; }
.backtest__context dt, .backtest__metric dt { color: var(--color-text-muted); font-size: 12px; margin-bottom: 0.2rem; }
.backtest__context dd, .backtest__metric dd { margin: 0; }
.backtest__metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin: 0; padding-top: 1.2rem; border-top: 1px solid var(--color-border); }
.backtest__metric dd { font-family: var(--font-mono); font-size: 1.35rem; color: var(--color-text); }
.num { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
.backtest-costs { margin-top: 1.5rem; font-size: 14px; color: var(--color-text-muted); max-width: 820px; }

/* Risques et limites */
.limits { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 0.9rem; max-width: 860px; }
.limits li { padding: 1rem 1.2rem; border: 1px solid var(--color-border-md); border-left: 2px solid var(--color-gold); border-radius: var(--radius-md); background: var(--color-bg-card); color: var(--color-text-muted); }
.limits strong { color: var(--color-text); }
</style>
{% endblock %}

{% block javascripts %}
<script>
function submitWaitlist(e) {
    e.preventDefault();
    const email = document.getElementById('wl-email').value.trim();
    const firstname = document.getElementById('wl-firstname').value.trim();

    if (!email) return;

    fetch('{{ path("app_trading_waitlist") }}', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json',
            'X-Requested-With': 'XMLHttpRequest'
        },
        body: JSON.stringify({ email, firstName: firstname, source: 'trading_page' })
    })
    .then(r => r.json())
    .then(() => {
        document.getElementById('waitlistForm').style.display = 'none';
        document.getElementById('waitlist-success').style.display = 'flex';
    })
    .catch(() => alert('Une erreur est survenue. Réessayez.'));
}
</script>
{% endblock %}
