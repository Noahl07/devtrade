{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Documentation trading{% endblock %}
{% block meta_description %}Documentation de trading structurée en modules progressifs : bases des marchés, analyse technique, méthodes quantitatives et gestion du risque.{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}

<header class="page-hero">
    <div class="container page-hero__grid">
        <div>
            <span class="eyebrow">Documentation</span>
            <h1>Comprendre <em>avant de trader.</em></h1>
            <p class="lead">Des modules progressifs, rédigés pour apprendre à raisonner : les bases, l'analyse, le risque, puis les méthodes quantitatives.</p>
            <ul class="page-hero__meta" aria-label="La documentation en chiffres">
                <li><strong>{{ totalArticles }}</strong><span>Articles</span></li>
                <li><strong>{{ moduleCount }}</strong><span>Modules</span></li>
                <li><strong>{{ totalMinutes }}</strong><span>Minutes de lecture</span></li>
            </ul>
        </div>

        <div class="member-card">
            {% if app.user %}
                <span class="eyebrow">Votre accès</span>
                <strong>{{ app.user.firstName }} {{ app.user.lastName }}</strong>
                {% if app.user.isPremium %}
                    <p>Accès Premium : tous les modules vous sont ouverts.</p>
                    {{ ui.badge('Premium', 'demo') }}
                {% else %}
                    <p>Accès gratuit : les modules gratuits vous sont ouverts. Les modules Premium sont signalés.</p>
                    {{ ui.button('Voir l\'accès Premium', path('app_pricing'), 'ghost', 'arrow-right') }}
                {% endif %}
            {% else %}
                <span class="eyebrow">Accès</span>
                <strong>Un compte gratuit suffit pour commencer</strong>
                <p>Les articles gratuits sont réservés aux membres inscrits. L'inscription ne demande qu'une adresse e-mail.</p>
                <div class="member-card__actions">
                    {{ ui.button('Créer un compte', path('app_register'), 'primary') }}
                    {{ ui.button('Se connecter', path('app_login'), 'secondary') }}
                </div>
            {% endif %}
        </div>
    </div>
</header>

<section class="section" aria-labelledby="modules-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Modules</span>
                <h2 id="modules-title">Un parcours, <em>dans l'ordre.</em></h2>
            </div>
            <p>Chaque module s'appuie sur le précédent. Les modules Premium sont indiqués clairement.</p>
        </div>

        {% if categories is not empty %}
            <ol class="editorial-list module-list" data-reveal>
                {% for category in categories %}
                    {% set count = articleCounts[category.slug] ?? 0 %}
                    {% set isPremium = category.accessLevel == 'premium' %}
                    {% set isLocked = isPremium and (not app.user or not app.user.isPremium) %}
                    <li class="editorial-list__item{{ isLocked ? ' is-locked' }}">
                        <span class="editorial-list__index">{{ '%02d'|format(loop.index) }}</span>
                        <div>
                            <h3 class="editorial-list__title">
                                <a href="{{ path('app_documentation_category', { slug: category.slug }) }}">{{ category.name }}</a>
                            </h3>
                            {% if category.description %}<p class="module-list__desc">{{ category.description }}</p>{% endif %}
                        </div>
                        <span class="module-list__meta">{{ count > 0 ? count ~ ' article' ~ (count > 1 ? 's') : 'Bientôt' }}</span>
                        <span class="module-list__meta">
                            {% if isLocked %}{{ ui.icon('lock', 'Module Premium, accès verrouillé') }}{% endif %}
                            {{ ui.badge(isPremium ? 'Premium' : 'Gratuit', isPremium ? 'demo' : 'backtest') }}
                        </span>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="works-empty"><p>Les premiers modules arrivent bientôt.</p></div>
        {% endif %}

        {{ ui.notice('Contenu éducatif : il ne constitue ni un conseil en investissement ni une recommandation personnalisée.', 'info', 'À savoir.') }}
    </div>
</section>

{% endblock %}
