{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}{{ document.title }}{% endblock %}
{% block meta_description %}{{ document.excerpt }}{% endblock %}
{% block og_type %}article{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}
<div class="read-progress" data-read-progress aria-hidden="true"></div>

<div class="container reading">
    <aside class="reading__aside" aria-label="Navigation de la documentation">
        {% include 'documentation/_search_form.html.twig' with { id: 'aside' } only %}
        <nav data-toc-wrap hidden aria-label="Sur cette page">
            <span class="reading__aside-title">Sur cette page</span>
            <ol class="toc" data-toc></ol>
        </nav>

        {% if document.category %}
            <nav aria-label="Articles du module">
                <span class="reading__aside-title">{{ document.category.name }}</span>
                <ol class="toc">
                    {% for sibling in document.category.documents|filter(d => d.isPublished) %}
                        {% set siblingLocked = sibling.isPremium() and (not app.user or not app.user.isPremium) %}
                        {% set siblingDone = progress[sibling.id] is defined and progress[sibling.id].completed %}
                        <li class="{{ siblingLocked ? 'is-locked' }}{{ siblingDone ? ' is-done' }}">
                            <a href="{{ path('app_documentation_article', { accessLevel: sibling.accessLevel, slug: sibling.slug }) }}"
                               {% if sibling.slug == document.slug %}aria-current="true"{% endif %}>
                                {{ sibling.title }}{% if siblingLocked %} <span class="visually-hidden">(Premium)</span>{% endif %}{% if siblingDone %} <span class="visually-hidden">(lu)</span>{% endif %}
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            </nav>
        {% endif %}

        {% include 'documentation/_modules_nav.html.twig' with { modules: modules, current: document.category } only %}
    </aside>

    <article>
        <header class="article-head">
            <ol class="breadcrumb">
                <li><a href="{{ path('app_documentation') }}">Documentation</a></li>
                {% if document.category %}
                    <li><a href="{{ path('app_documentation_category', { slug: document.category.slug }) }}">{{ document.category.name }}</a></li>
                {% endif %}
            </ol>
            <div class="article-head__meta">
                {{ ui.badge(document.isPremium() ? 'Premium' : 'Gratuit', document.isPremium() ? 'demo' : 'backtest') }}
                {% if document.readingTime %}<span>{{ ui.icon('clock') }} {{ document.readingTime }} min de lecture</span>{% endif %}
                {% if document.publishedAt %}<span>{{ ui.icon('calendar') }} {{ document.publishedAt|date('d/m/Y') }}</span>{% endif %}
            </div>
            <h1>{{ document.title }}</h1>
            {% if document.excerpt %}<p class="lead">{{ document.excerpt }}</p>{% endif %}
        </header>

        <div class="prose" data-reading-body
             {% if current %}data-progress-url="{{ path('app_documentation_progress', { id: document.id }) }}"
             data-progress-token="{{ csrf_token('progress') }}"
             data-progress-done="{{ current.completed ? '1' : '0' }}"{% endif %}>
            {{ document.content|sanitize_html }}
        </div>

        {% if current %}
            <form class="article-done" method="post" action="{{ path('app_documentation_progress', { id: document.id }) }}" data-progress-form>
                <input type="hidden" name="_token" value="{{ csrf_token('progress') }}">
                <input type="hidden" name="action" value="{{ current.completed ? 'non-lu' : 'lu' }}">
                <p class="article-done__state" data-progress-state>
                    {% if current.completed %}{{ ui.icon('check') }} Article terminé le {{ current.completedAt|date('d/m/Y') }}.
                    {% else %}L'article est marqué comme lu quand vous arrivez à la fin.{% endif %}
                    {% if current.quizTotal %}<span class="article-done__quiz">Meilleur score au quiz : {{ current.quizScore }} / {{ current.quizTotal }}</span>{% endif %}
                </p>
                <button type="submit" class="button button--ghost" data-progress-toggle>{{ current.completed ? 'Marquer comme non lu' : 'Marquer comme lu' }}</button>
            </form>
        {% endif %}

        <footer class="article-foot">
            {% if document.category %}
                {{ ui.button('Retour au module', path('app_documentation_category', { slug: document.category.slug }), 'ghost', 'arrow-right') }}
            {% endif %}
            {% if app.user and not app.user.isPremium %}
                {{ ui.button('Voir l\'accès Premium', path('app_pricing'), 'secondary') }}
            {% endif %}
        </footer>

        {{ ui.notice('Contenu éducatif : il ne constitue ni un conseil en investissement ni une recommandation personnalisée.', 'info', 'À savoir.') }}
    </article>
</div>

{% endblock %}
