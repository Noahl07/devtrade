{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}{{ category.name }} · Documentation{% endblock %}
{% block meta_description %}{{ category.description ?: 'Module de la documentation trading de dev.trade.' }}{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}
{% set isPremium = category.accessLevel == 'premium' %}
{% set isLocked = isPremium and (not app.user or not app.user.isPremium) %}

<header class="page-hero">
    <div class="container">
        <ol class="breadcrumb">
            <li><a href="{{ path('app_documentation') }}">Documentation</a></li>
            <li aria-current="page">{{ category.name }}</li>
        </ol>
        <span class="eyebrow">Module · {{ documents|length }} article{{ documents|length > 1 ? 's' }}</span>
        <h1>{{ category.name }}</h1>
        {% if category.description %}<p class="lead">{{ category.description }}</p>{% endif %}
        <div class="page-hero__meta">{{ ui.badge(isPremium ? 'Premium' : 'Gratuit', isPremium ? 'demo' : 'backtest') }}</div>
    </div>
</header>

<div class="container reading reading--module">
    <aside class="reading__aside" aria-label="Navigation de la documentation">
        {% include 'documentation/_search_form.html.twig' with { id: 'aside' } only %}
        {% include 'documentation/_modules_nav.html.twig' with { modules: modules, current: category } only %}
    </aside>

    <div>
        {% if isLocked %}
            <div class="locked-panel">
                {{ ui.icon('lock') }}
                <div>
                    <h2>Module Premium</h2>
                    <p class="muted">Ce module fait partie de l'accès Premium.</p>
                    <div class="member-card__actions">
                        {% if app.user %}
                            {{ ui.button('Voir l\'accès Premium', path('app_pricing'), 'primary', 'arrow-right') }}
                        {% else %}
                            {{ ui.button('Créer un compte', path('app_register'), 'primary') }}
                            {{ ui.button('Se connecter', path('app_login'), 'secondary') }}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% elseif documents is empty %}
            <div class="works-empty"><p>Les articles de ce module arrivent bientôt.</p></div>
        {% else %}
            {% if app.user %}
                {% set done = documents|filter(d => progress[d.id] is defined and progress[d.id].completed)|length %}
                <div class="module-progress" role="group" aria-label="Votre avancement dans ce module">
                    <progress class="module-progress__bar" max="{{ documents|length }}" value="{{ done }}"></progress>
                    <p>{{ done }} / {{ documents|length }} article{{ documents|length > 1 ? 's' }} terminé{{ done > 1 ? 's' }}</p>
                </div>
            {% endif %}
            <ol class="editorial-list module-list">
                {% for document in documents %}
                    {% set docLocked = document.isPremium() and (not app.user or not app.user.isPremium) %}
                    {% set docProgress = progress[document.id] ?? null %}
                    <li class="editorial-list__item{{ docLocked ? ' is-locked' }}{{ docProgress and docProgress.completed ? ' is-done' }}" data-reveal>
                        <span class="editorial-list__index">{% if docProgress and docProgress.completed %}{{ ui.icon('check', 'Article terminé') }}{% else %}{{ '%02d'|format(loop.index) }}{% endif %}</span>
                        <div>
                            <h3 class="editorial-list__title">
                                <a href="{{ path('app_documentation_article', { accessLevel: document.accessLevel, slug: document.slug }) }}">{{ document.title }}</a>
                            </h3>
                            {% if document.excerpt %}<p class="module-list__desc">{{ document.excerpt }}</p>{% endif %}
                        </div>
                        <span class="module-list__meta">{% if document.readingTime %}{{ ui.icon('clock') }} {{ document.readingTime }} min{% endif %}</span>
                        <span class="module-list__meta">
                            {% if docProgress and docProgress.quizTotal %}<span class="module-list__quiz" title="Meilleur score au quiz">Quiz {{ docProgress.quizScore }}/{{ docProgress.quizTotal }}</span>{% endif %}
                            {% if docProgress and not docProgress.completed %}<span class="module-list__started">Commencé</span>{% endif %}
                            {% if docLocked %}{{ ui.icon('lock', 'Article Premium, accès verrouillé') }}{% endif %}
                            {% if document.isPremium() %}{{ ui.badge('Premium', 'demo') }}{% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}

        <p class="works__more">{{ ui.button('Tous les modules', path('app_documentation'), 'ghost', 'arrow-right') }}</p>
    </div>
</div>

{% endblock %}
