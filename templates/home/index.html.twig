{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import _self as home %}

{% block title %}Développement fullstack et trading algorithmique{% endblock %}
{% block meta_description %}Applications web sur mesure (Symfony, PHP, PostgreSQL) et recherche en trading algorithmique, menées avec la même exigence : mesurer, tester, publier ce qui est vérifiable.{% endblock %}

{# Page refondue : pas d'ancien CSS #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block structured_data %}
    {# JSON-LD sans note ni avis (PROMPT-REFONTE §2.4) #}
    <script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@type': 'Organization',
            name: 'dev.trade',
            url: absolute_url(path('app_home')),
            email: contact_email,
            description: 'Développement fullstack et trading algorithmique.',
        }|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}
        {# |raw justifié : JSON construit ici, balises échappées par JSON_HEX_TAG. #}
    </script>
{% endblock %}

{% block body %}

{# ══ HÉROS ══ #}
<section class="hero" aria-labelledby="hero-title">
    {# Illustration SVG par défaut ; remplacée par la scène 3D si l'appareil le permet (assets/site.js) #}
    <div class="hero-art" data-hero-scene aria-hidden="true"></div>

    <div class="container">
        <div class="hero__content">
            <span class="eyebrow">Développement fullstack · Trading algorithmique</span>
            <h1 class="hero__title" id="hero-title">
                Du logiciel sur mesure,<br>
                <em>des marchés étudiés avec méthode.</em>
            </h1>
            <p class="lead hero__lead">
                dev.trade conçoit des applications web robustes pour les entreprises et mène une recherche
                quantitative sur les marchés, avec la même exigence : mesurer, tester, publier ce qui est vérifiable.
            </p>
            <div class="hero__actions">
                {{ ui.button('Démarrer un projet', path('app_contact'), 'primary', 'arrow-right') }}
                {{ ui.button('Découvrir ' ~ product_name, path('app_trading'), 'secondary') }}
            </div>
        </div>

        <dl class="hero__meta">
            <div>
                <dt>Développement</dt>
                <dd>Symfony, PHP 8.4, PostgreSQL, du cadrage à la mise en production.</dd>
            </div>
            <div>
                <dt>Trading</dt>
                <dd>Recherche quantitative, documentation, robot MetaTrader 5 en test.</dd>
            </div>
            <div>
                <dt>Principe</dt>
                <dd>Chaque chiffre publié l'est avec sa période, son échantillon et ses limites.</dd>
            </div>
        </dl>
    </div>
</section>

{# ══ DEUX MÉTIERS ══ #}
<section class="section" aria-labelledby="metiers-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Deux métiers</span>
                <h2 id="metiers-title">Une même rigueur, <em>deux terrains.</em></h2>
            </div>
            <p>Construire un logiciel fiable et étudier un marché demandent les mêmes réflexes :
                partir des données, tester chaque hypothèse, documenter ce qui marche et ce qui ne marche pas.</p>
        </div>

        <div class="doors">
            <a class="door door--dev" href="{{ path('app_portfolio') }}" data-reveal>
                <span class="door__index">01 · Développement</span>
                <h3 class="door__title">Applications web sur mesure</h3>
                <p class="door__text">Sites, back-offices, espaces clients et API, conçus pour durer et faciles à faire évoluer.</p>
                <ul class="door__list">
                    <li>{{ ui.icon('code') }} Symfony, PHP 8.4, PostgreSQL, Twig</li>
                    <li>{{ ui.icon('lock') }} Sécurité et performance dès la conception</li>
                    <li>{{ ui.icon('shield') }} Déploiement conteneurisé, maintenance suivie</li>
                </ul>
                <span class="door__cta">Voir les réalisations {{ ui.icon('arrow-right') }}</span>
            </a>

            <a class="door door--trading" href="{{ path('app_trading') }}" data-reveal>
                <span class="door__index">02 · Trading algorithmique</span>
                <h3 class="door__title">Méthodes, données, limites</h3>
                <p class="door__text">Recherche quantitative et outils d'exécution, documentés et testés. Aucune promesse de gain.</p>
                <ul class="door__list">
                    <li>{{ ui.icon('chart') }} {{ product_name }}, robot MT5 sur USDJPY, en test démo</li>
                    <li>{{ ui.icon('book') }} Documentation : analyse technique, orderflow, quant</li>
                    <li>{{ ui.icon('info') }} Backtests publiés avec leur contexte complet</li>
                </ul>
                <span class="door__cta">Découvrir {{ product_name }} {{ ui.icon('arrow-right') }}</span>
            </a>
        </div>
    </div>
</section>

{# ══ RÉALISATIONS (données réelles uniquement) ══ #}
<section class="section" aria-labelledby="realisations-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Réalisations</span>
                <h2 id="realisations-title">Des projets livrés, <em>pas des maquettes.</em></h2>
            </div>
            <p>Chaque étude de cas présente le contexte, la technique retenue et le résultat obtenu.</p>
        </div>

        {% if featuredProjects is not empty %}
            {% set lead = featuredProjects|first %}
            <div class="works">
                {{ home.work(lead, false) }}
                {% if featuredProjects|length > 1 %}
                    <div class="works__side">
                        {% for project in featuredProjects|slice(1) %}
                            {{ home.work(project, true) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
            <p class="works__more">{{ ui.button('Toutes les réalisations', path('app_portfolio'), 'ghost', 'arrow-right') }}</p>
        {% else %}
            {# TODO : ajouter les vraies réalisations (autorisées à la publication) depuis l'admin, « mises en avant ». #}
            <div class="works-empty" data-reveal>
                <div>
                    <h3>Études de cas en cours de rédaction</h3>
                    <p>Les premières réalisations détaillées arrivent bientôt. En attendant, parlons de votre projet.</p>
                </div>
                {{ ui.button('Démarrer un projet', path('app_contact'), 'secondary', 'arrow-right') }}
            </div>
        {% endif %}
    </div>
</section>

{# ══ SHIRO (aucun chiffre de performance ici : voir la page produit) ══ #}
<section class="shiro-band" aria-labelledby="shiro-title">
    <div class="container shiro-band__grid">
        <div data-reveal>
            <span class="eyebrow">Trading algorithmique · {{ product_name }}</span>
            <h2 id="shiro-title">Un seul mécanisme.<br><em>Aucune promesse.</em></h2>
            <p class="lead">{{ product_name }} est un robot MetaTrader 5 qui exploite une inefficacité récurrente et documentée
                du marché USDJPY, quelques jours par mois seulement.</p>
            <div class="shiro-band__badges">
                {{ ui.badge('En test sur compte démo', 'demo') }}
                {{ ui.badge('USDJPY', 'backtest') }}
                {{ ui.badge('MetaTrader 5', 'backtest') }}
            </div>
            <div class="shiro-band__actions">
                {{ ui.button('La méthode et ses limites', path('app_trading'), 'secondary', 'arrow-right') }}
                {{ ui.button('Être prévenu de la sortie', path('app_trading') ~ '#liste-attente', 'ghost', 'arrow-right') }}
            </div>
            {{ ui.notice('En test sur compte démo depuis le ' ~ demo_since ~ '. Aucun historique réel vérifié à ce jour.', 'info', 'Statut.') }}
        </div>

        <dl class="spec-card" data-reveal>
            <div><dt>Marché</dt><dd>USDJPY</dd></div>
            <div><dt>Plateforme</dt><dd>MetaTrader 5</dd></div>
            <div><dt>Séance</dt><dd>Asie, quelques jours par mois</dd></div>
            <div><dt>Exposition</dt><dd>Courte, jamais la nuit</dd></div>
            <div><dt>Risque</dt><dd>0,5 à 1,5 % par trade</dd></div>
            <div><dt>Statut</dt><dd>Démo depuis le {{ demo_since }}</dd></div>
        </dl>
    </div>
</section>

{# ══ DOCUMENTATION ══ #}
{% if categories is not empty %}
<section class="section" aria-labelledby="doc-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Documentation</span>
                <h2 id="doc-title">Comprendre avant <em>de trader.</em></h2>
            </div>
            <p>Des modules progressifs, de l'analyse technique aux méthodes quantitatives.
                {{ ui.button('Toute la documentation', path('app_documentation'), 'ghost', 'arrow-right') }}</p>
        </div>

        <ol class="editorial-list doc-list" data-reveal>
            {% for item in categories %}
                {% set category = item.entity %}
                <li class="editorial-list__item">
                    <span class="editorial-list__index">{{ '%02d'|format(loop.index) }}</span>
                    <div>
                        <h3 class="editorial-list__title">
                            <a href="{{ path('app_documentation_category', { slug: category.slug }) }}">{{ category.name }}</a>
                        </h3>
                        {% if category.description %}<p class="doc-list__desc">{{ category.description }}</p>{% endif %}
                    </div>
                    <span class="muted small num">{{ item.count }} article{{ item.count > 1 ? 's' }}</span>
                    {{ ui.badge(category.accessLevel == 'premium' ? 'Premium' : 'Gratuit', category.accessLevel == 'premium' ? 'demo' : 'backtest') }}
                </li>
            {% endfor %}
        </ol>
    </div>
</section>
{% endif %}

{# ══ APPEL FINAL ══ #}
<section class="closing" aria-labelledby="closing-title">
    <div class="container" data-reveal>
        <hr class="rule rule--gold">
        <span class="eyebrow">Contact</span>
        <h2 class="closing__title" id="closing-title">Un projet à construire, <em>une question à poser ?</em></h2>
        <p class="lead">Décrivez votre besoin ou votre question : vous recevrez une réponse personnelle.</p>
        <div class="closing__row">
            {{ ui.button('Écrire un message', path('app_contact'), 'primary', 'arrow-right') }}
            <span class="closing__email">{{ contact_email }}</span>
        </div>
    </div>
</section>

{% endblock %}

{# ── Carte de réalisation ── #}
{% macro work(project, small) %}
    {%- import 'components/ui/_ui.html.twig' as ui -%}
    <article class="work{{ small ? ' work--small' }}" data-reveal>
        <div class="work__media">
            {% if project.imageUrl %}
                <img src="{{ project.imageUrl }}" alt="" loading="lazy" decoding="async" width="1280" height="800">
            {% else %}
                <span class="work__monogram" aria-hidden="true">{{ project.title|first|upper }}</span>
            {% endif %}
        </div>
        <div class="work__body">
            {% if project.type %}<span class="work__type">{{ project.type }}</span>{% endif %}
            <h3 class="work__title"><a href="{{ path('app_portfolio_project', { slug: project.slug }) }}">{{ project.title }}</a></h3>
            {% if project.shortDesc %}<p class="work__desc">{{ project.shortDesc }}</p>{% endif %}
            {% if project.techStack is not empty %}
                <ul class="stack-list" aria-label="Technologies">
                    {% for tech in project.techStack|slice(0, 5) %}<li>{{ tech }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
    </article>
{% endmacro %}
