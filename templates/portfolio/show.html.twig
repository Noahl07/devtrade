{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}{{ project.title }}{% endblock %}
{% block meta_description %}{{ project.shortDesc }}{% endblock %}
{% block og_type %}article{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}

<header class="page-hero">
    <div class="container">
        <ol class="breadcrumb">
            <li><a href="{{ path('app_portfolio') }}">Développement</a></li>
            <li aria-current="page">{{ project.title }}</li>
        </ol>
        {% if project.type %}<span class="eyebrow">{{ project.type }}</span>{% endif %}
        <h1>{{ project.title }}</h1>
        {% if project.shortDesc %}<p class="lead">{{ project.shortDesc }}</p>{% endif %}
    </div>
</header>

<div class="container case">
    <article>
        {% if project.imageUrl %}
            <figure class="case__media">
                <img src="{{ project.imageUrl }}" alt="{{ project.title }}" width="1280" height="800" decoding="async">
            </figure>
        {% endif %}
        <div class="prose">
            {{ project.description|sanitize_html }}
        </div>
    </article>

    <aside class="case__aside" aria-label="Informations sur le projet">
        {% if project.techStack is not empty %}
            <div class="case__panel">
                <h2>Technologies</h2>
                <ul class="stack-list">
                    {% for tech in project.techStack %}<li>{{ tech }}</li>{% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if project.projectUrl or project.githubUrl %}
            <div class="case__panel">
                <h2>Liens</h2>
                <div class="case__links">
                    {% if project.projectUrl %}
                        <a class="button button--secondary button--sm" href="{{ project.projectUrl }}" target="_blank" rel="noopener noreferrer">Voir le site {{ ui.icon('arrow-up-right') }}</a>
                    {% endif %}
                    {% if project.githubUrl %}
                        <a class="button button--secondary button--sm" href="{{ project.githubUrl }}" target="_blank" rel="noopener noreferrer">Voir le code {{ ui.icon('arrow-up-right') }}</a>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <div class="case__panel">
            <h2>Un projet similaire ?</h2>
            <p class="muted small">Décrivez votre besoin, vous recevrez une réponse personnelle.</p>
            {{ ui.button('Démarrer un projet', path('app_contact'), 'primary', 'arrow-right') }}
        </div>

        {{ ui.button('Toutes les réalisations', path('app_portfolio'), 'ghost', 'arrow-right') }}
    </aside>
</div>

{% endblock %}
