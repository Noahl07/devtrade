{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Développement fullstack : prestations et réalisations{% endblock %}
{% block meta_description %}Applications web sur mesure avec Symfony, PHP 8.4 et PostgreSQL : sites, back-offices, espaces clients et API, du cadrage à la mise en production.{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}

<header class="page-hero">
    <div class="container page-hero__grid">
        <div>
            <span class="eyebrow">Développement fullstack</span>
            <h1>Des applications <em>qui durent.</em></h1>
            <p class="lead">Sites, back-offices, espaces clients et API, conçus pour être fiables, sûrs et faciles à faire évoluer.</p>
        </div>
        <div>
            {{ ui.button('Démarrer un projet', path('app_contact'), 'primary', 'arrow-right') }}
        </div>
    </div>
</header>

{# ══ PRESTATIONS ══ #}
<section class="section" aria-labelledby="prestations-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Prestations</span>
                <h2 id="prestations-title">Du cadrage <em>à la production.</em></h2>
            </div>
            <p>Chaque projet commence par un devis détaillé : périmètre, délais estimés et tarif.</p>
        </div>
        <ol class="services">
            <li data-reveal><span class="editorial-list__index">01</span><h3>Applications métier</h3>
                <p>Outils internes, back-offices et tableaux de bord adaptés à votre façon de travailler, avec gestion fine des rôles.</p></li>
            <li data-reveal><span class="editorial-list__index">02</span><h3>Sites et espaces clients</h3>
                <p>Sites sur mesure avec contenu administrable, espace client sécurisé et formulaires métier.</p></li>
            <li data-reveal><span class="editorial-list__index">03</span><h3>API et intégrations</h3>
                <p>API documentées, connexions à des services tiers, automatisation de tâches récurrentes.</p></li>
            <li data-reveal><span class="editorial-list__index">04</span><h3>Reprise et sécurisation</h3>
                <p>Audit de code, mise à jour de PHP et de Symfony, correction des failles et mise en place de tests.</p></li>
        </ol>
    </div>
</section>

{# ══ RÉALISATIONS (base de données uniquement) ══ #}
<section class="section" aria-labelledby="realisations-title">
    <div class="container">
        <div class="section-head" data-reveal>
            <div>
                <span class="eyebrow">Réalisations</span>
                <h2 id="realisations-title">Études <em>de cas.</em></h2>
            </div>
            <p>Le contexte, la technique retenue et le résultat de chaque projet.</p>
        </div>

        {% if projects is not empty %}
            <div class="project-grid">
                {% for project in projects %}
                    {% include 'components/_work_card.html.twig' with { project: project } only %}
                {% endfor %}
            </div>
        {% else %}
            {# TODO : publier les vraies réalisations (autorisées par les clients) depuis l'administration. #}
            <div class="works-empty" data-reveal>
                <div>
                    <h3>Études de cas en cours de rédaction</h3>
                    <p>Les premières réalisations détaillées arrivent bientôt. En attendant, parlons de votre projet.</p>
                </div>
                {{ ui.button('Démarrer un projet', path('app_contact'), 'secondary', 'arrow-right') }}
            </div>
        {% endif %}
    </div>
</section>

<section class="closing" aria-labelledby="closing-title">
    <div class="container" data-reveal>
        <hr class="rule rule--gold">
        <span class="eyebrow">Devis</span>
        <h2 class="closing__title" id="closing-title">Un projet en tête, <em>un besoin précis ?</em></h2>
        <p class="lead">Décrivez votre besoin : vous recevrez une réponse personnelle et, si le projet s'y prête, un devis détaillé.</p>
        <div class="closing__row">
            {{ ui.button('Écrire un message', path('app_contact'), 'primary', 'arrow-right') }}
            <span class="closing__email">{{ contact_email }}</span>
        </div>
    </div>
</section>

{% endblock %}
