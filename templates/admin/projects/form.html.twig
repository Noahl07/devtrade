{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import 'admin/_form.html.twig' as f %}

{% set isNew = project.id is null %}
{% set defaults = {
    title: project.title, slug: project.slug, type: project.type, shortDesc: project.shortDesc,
    description: project.description, techStack: project.techStack|join(', '), imageUrl: project.imageUrl,
    projectUrl: project.projectUrl, githubUrl: project.githubUrl, position: project.position,
    isVisible: project.isVisible, isFeatured: project.isFeatured,
} %}
{% set v = values is null ? defaults : defaults|merge(values) %}

{% block admin_title %}{{ isNew ? 'Nouvelle réalisation' : 'Modifier la réalisation' }}{% endblock %}
{% block admin_breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb"><li><a href="{{ path('app_admin_projects') }}">Réalisations</a></li><li aria-current="page">{{ isNew ? 'Nouvelle' : project.title }}</li></ol></nav>{% endblock %}
{% block admin_lead %}<p class="admin__lead">Publiez uniquement des projets réels, avec l'accord du client si nécessaire.</p>{% endblock %}

{% block admin_content %}
<form method="post" class="admin-form" data-dirty-guard novalidate>
    <input type="hidden" name="_token" value="{{ csrf_token('admin_form') }}">
    {{ f.summary(errors) }}

    <div class="admin-editor-layout">
        <div class="admin-editor-main admin-panel admin-form__grid">
            {{ f.input('title', 'Titre', v.title, errors, {required: true, maxlength: 150, wide: true, attr: {'data-slug-source': ''}}) }}
            {{ f.input('shortDesc', 'Résumé', v.shortDesc, errors, {required: true, maxlength: 255, wide: true, help: 'Une phrase, affichée sur la carte de la page Développement.'}) }}
            {{ f.textarea('description', 'Description (HTML)', v.description, errors, {required: true, rows: 12, help: 'Page détaillée du projet. Le HTML est nettoyé à l\'affichage.'}) }}
            {{ f.input('techStack', 'Technologies', v.techStack, errors, {wide: true, placeholder: 'Symfony, PostgreSQL, Docker', help: 'Séparées par des virgules.'}) }}
        </div>

        <aside class="admin-editor-side">
            <div class="admin-panel">
                <h2 class="admin-panel__title">Affichage</h2>
                {{ f.toggle('isVisible', 'Visible sur le site', (values is null ? defaults.isVisible : values.isVisible is defined)) }}
                {{ f.toggle('isFeatured', 'Mis en avant', (values is null ? defaults.isFeatured : values.isFeatured is defined), 'Apparaît sur la page d\'accueil.') }}
            </div>
            <div class="admin-panel admin-form__stack">
                {{ f.select('type', 'Type', types, v.type ?? 'fullstack', errors) }}
                {{ f.input('position', 'Ordre', v.position, errors, {type: 'number', min: 0, max: 9999, help: 'Plus petit = affiché en premier.'}) }}
                {{ f.input('slug', 'Adresse (slug)', v.slug, errors, {mono: true, maxlength: 170, placeholder: 'générée depuis le titre', attr: {'data-slug-target': ''}}) }}
                {{ f.input('imageUrl', 'Image', v.imageUrl, errors, {type: 'text', maxlength: 255, placeholder: 'https://… ou /images/…', help: 'Format 16:10 conseillé (1280 × 800).'}) }}
                {{ f.input('projectUrl', 'Lien du projet', v.projectUrl, errors, {type: 'url', maxlength: 255, placeholder: 'https://…'}) }}
                {{ f.input('githubUrl', 'Code source', v.githubUrl, errors, {type: 'url', maxlength: 255, placeholder: 'https://github.com/…'}) }}
            </div>
        </aside>
    </div>

    <div class="admin-form__bar">
        {% if not isNew %}
            <button type="submit" form="delete-project" class="button button--ghost admin-danger-link">{{ ui.icon('trash') }} Supprimer</button>
        {% endif %}
        <span class="admin-form__spacer"></span>
        {{ ui.button('Annuler', path('app_admin_projects'), 'ghost') }}
        <button type="submit" class="button button--primary">{{ isNew ? 'Créer la réalisation' : 'Enregistrer' }} {{ ui.icon('check') }}</button>
    </div>
</form>

{% if not isNew %}
    <form id="delete-project" method="post" action="{{ path('app_admin_project_delete', {id: project.id}) }}" data-confirm="Supprimer définitivement « {{ project.title }} » ?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
    </form>
{% endif %}
{% endblock %}
