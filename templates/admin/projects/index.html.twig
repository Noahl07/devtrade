{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block admin_title %}Réalisations{% endblock %}
{% block admin_lead %}<p class="admin__lead">Projets affichés sur la page Développement, dans l'ordre indiqué.</p>{% endblock %}
{% block admin_actions %}{{ ui.button('Nouvelle réalisation', path('app_admin_project_new'), 'primary', 'plus') }}{% endblock %}

{% block admin_content %}
{% if projects is empty %}
    <div class="admin-panel admin-empty-state">
        <p><strong>Aucune réalisation.</strong> La page Développement présente vos services en attendant.</p>
        {{ ui.button('Ajouter la première', path('app_admin_project_new'), 'secondary', 'plus') }}
    </div>
{% else %}
<div class="table-wrap">
    <table class="data-table admin-table">
        <caption class="visually-hidden">Réalisations, par ordre d'affichage</caption>
        <thead><tr><th scope="col" class="num">Ordre</th><th scope="col">Titre</th><th scope="col">Type</th><th scope="col">Affichage</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td class="num">{{ project.position }}</td>
                <th scope="row"><a class="admin-table__title" href="{{ path('app_admin_project_edit', {id: project.id}) }}">{{ project.title }}</a><small>{{ project.shortDesc }}</small></th>
                <td>{{ project.type }}</td>
                <td><span class="admin-table__badges">{{ project.isVisible ? ui.badge('Visible', 'live') : ui.badge('Masqué', 'soon') }}{% if project.isFeatured %}{{ ui.badge('En avant', 'demo') }}{% endif %}</span></td>
                <td>
                    <div class="admin-table__actions">
                        {% if project.isVisible %}<a class="admin-icon-btn" href="{{ path('app_portfolio_project', {slug: project.slug}) }}" target="_blank" rel="noopener" aria-label="Voir « {{ project.title }} » sur le site">{{ ui.icon('arrow-up-right') }}</a>{% endif %}
                        <a class="admin-icon-btn" href="{{ path('app_admin_project_edit', {id: project.id}) }}" aria-label="Modifier « {{ project.title }} »">{{ ui.icon('edit') }}</a>
                        <form method="post" action="{{ path('app_admin_project_delete', {id: project.id}) }}" data-confirm="Supprimer définitivement « {{ project.title }} » ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-project-' ~ project.id) }}">
                            <button class="admin-icon-btn admin-icon-btn--danger" aria-label="Supprimer « {{ project.title }} »">{{ ui.icon('trash') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
