{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block admin_title %}Liste d'attente {{ product_name }}{% endblock %}
{% block admin_lead %}<p class="admin__lead">{{ entries|length }} inscription{{ entries|length > 1 ? 's' }}. Données personnelles : à n'utiliser que pour annoncer la sortie, et à supprimer sur simple demande.</p>{% endblock %}
{% block admin_actions %}
    {% if entries is not empty %}<a class="button button--secondary" href="{{ path('app_admin_waitlist_export') }}">{{ ui.icon('download') }} Exporter (CSV)</a>{% endif %}
{% endblock %}

{% block admin_content %}
{% if entries is empty %}
    <p class="admin-empty">Personne n'est encore inscrit.</p>
{% else %}
<div class="table-wrap">
    <table class="data-table admin-table">
        <caption class="visually-hidden">Inscriptions à la liste d'attente, de la plus récente à la plus ancienne</caption>
        <thead><tr><th scope="col">E-mail</th><th scope="col">Prénom</th><th scope="col">Source</th><th scope="col">Inscription</th><th scope="col">Consentement</th><th scope="col">Prévenu</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
        {% for entry in entries %}
            <tr>
                <th scope="row" class="admin-table__email">{{ entry.email }}</th>
                <td>{{ entry.firstName ?: '—' }}</td>
                <td><span class="mono small">{{ entry.source }}</span></td>
                <td class="num">{{ entry.createdAt|date('d/m/Y') }}</td>
                <td>{% if entry.consentAt %}<span class="num">{{ entry.consentAt|date('d/m/Y') }}</span>{% else %}{{ ui.badge('Non recueilli', 'soon') }}{% endif %}</td>
                <td>{{ entry.isNotified ? ui.badge('Oui', 'live') : ui.badge('Non', 'backtest') }}</td>
                <td>
                    <div class="admin-table__actions">
                        <form method="post" action="{{ path('app_admin_waitlist_delete', {id: entry.id}) }}" data-confirm="Supprimer l'inscription de {{ entry.email }} ? (droit à l'effacement)">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-waitlist-' ~ entry.id) }}">
                            <button class="admin-icon-btn admin-icon-btn--danger" aria-label="Supprimer l'inscription de {{ entry.email }}">{{ ui.icon('trash') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<p class="field__help">Les inscriptions sans consentement datent d'avant la case à cocher : ne leur écrivez pas sans leur redemander leur accord.</p>
{% endif %}
{% endblock %}
