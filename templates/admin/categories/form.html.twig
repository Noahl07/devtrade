{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import 'admin/_form.html.twig' as f %}

{% set isNew = category.id is null %}
{% set defaults = {
    name: category.name, slug: category.slug, description: category.description,
    icon: category.icon, accessLevel: category.accessLevel,
} %}
{% set v = values is null ? defaults : defaults|merge(values) %}

{% block admin_title %}{{ isNew ? 'Nouveau module' : 'Modifier le module' }}{% endblock %}
{% block admin_breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb"><li><a href="{{ path('app_admin_categories') }}">Modules</a></li><li aria-current="page">{{ isNew ? 'Nouveau' : category.name }}</li></ol></nav>{% endblock %}

{% block admin_content %}
<form method="post" class="admin-form" data-dirty-guard novalidate>
    <input type="hidden" name="_token" value="{{ csrf_token('admin_form') }}">
    {{ f.summary(errors) }}

    <div class="admin-panel admin-form__grid">
        {{ f.input('name', 'Nom', v.name, errors, {required: true, maxlength: 100, attr: {'data-slug-source': ''}}) }}
        {{ f.select('accessLevel', 'Accès', access_levels, v.accessLevel ?? 'free', errors, {help: 'Le module entier est verrouillé s\'il est Premium.'}) }}
        {{ f.input('slug', 'Adresse (slug)', v.slug, errors, {mono: true, maxlength: 120, placeholder: 'générée depuis le nom', help: isNew ? 'Laissez vide pour la générer : /documentation/categorie/…' : 'Changer l\'adresse casse les liens existants.', attr: {'data-slug-target': ''}}) }}
        {{ f.input('icon', 'Icône (optionnel)', v.icon, errors, {mono: true, maxlength: 50, help: 'Nom d\'icône, conservé pour plus tard ; non affiché sur le site actuellement.'}) }}
        {{ f.textarea('description', 'Description', v.description, errors, {rows: 3, help: 'Affichée sous le titre du module.'}) }}
    </div>

    <div class="admin-form__bar">
        {{ ui.button('Annuler', path('app_admin_categories'), 'ghost') }}
        <button type="submit" class="button button--primary">{{ isNew ? 'Créer le module' : 'Enregistrer' }} {{ ui.icon('check') }}</button>
    </div>
</form>
{% endblock %}
