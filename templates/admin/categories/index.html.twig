{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import 'admin/_form.html.twig' as f %}

{% block admin_title %}Modules{% endblock %}
{% block admin_lead %}<p class="admin__lead">{{ categories|length }} module{{ categories|length > 1 ? 's' }}. Glissez les poignées, ou utilisez les flèches, pour changer l'ordre ; il est enregistré aussitôt.</p>{% endblock %}
{% block admin_actions %}{{ ui.button('Nouveau module', path('app_admin_category_new'), 'primary', 'plus') }}{% endblock %}

{% block admin_content %}
{% if categories is empty %}
    <p class="admin-empty">Aucun module. Créez-en un pour commencer la documentation.</p>
{% else %}
<ol class="admin-sortable" data-sortable data-reorder-url="{{ path('app_admin_categories_reorder') }}" aria-label="Ordre des modules">
    {% for cat in categories %}
        {% set docs = documentsByCategory[cat.id] ?? [] %}
        <li class="admin-module" data-id="{{ cat.id }}" draggable="true">
            <div class="admin-module__row">
                <span class="admin-sortable__handle" data-drag-handle title="Glisser pour déplacer">{{ ui.icon('grip') }}</span>
                <span class="admin-sortable__pos num" data-position>{{ loop.index }}</span>
                <div class="admin-module__main">
                    <strong>{{ cat.name }}</strong>
                    <small class="mono">/{{ cat.slug }}</small>
                </div>
                <div class="admin-module__meta">
                    {{ f.access_badge(cat.accessLevel) }}
                    <span class="muted small num">{{ docs|length }} article{{ docs|length > 1 ? 's' }}</span>
                </div>
                <div class="admin-module__actions">
                    <button type="button" class="admin-icon-btn" data-move="up" aria-label="Monter « {{ cat.name }} »">{{ ui.icon('arrow-up') }}</button>
                    <button type="button" class="admin-icon-btn" data-move="down" aria-label="Descendre « {{ cat.name }} »">{{ ui.icon('arrow-down') }}</button>
                    <a class="admin-icon-btn" href="{{ path('app_admin_category_edit', {id: cat.id}) }}" aria-label="Modifier « {{ cat.name }} »">{{ ui.icon('edit') }}</a>
                    {% if docs is empty %}
                        <form method="post" action="{{ path('app_admin_category_delete', {id: cat.id}) }}" data-confirm="Supprimer le module « {{ cat.name }} » ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-cat-' ~ cat.id) }}">
                            <button class="admin-icon-btn admin-icon-btn--danger" aria-label="Supprimer « {{ cat.name }} »">{{ ui.icon('trash') }}</button>
                        </form>
                    {% else %}
                        <span class="admin-icon-btn is-disabled" title="Contient des articles : suppression impossible">{{ ui.icon('lock', 'Suppression impossible : le module contient des articles') }}</span>
                    {% endif %}
                </div>
            </div>

            {% if docs is not empty %}
                <details class="admin-module__docs">
                    <summary>Articles du module {{ ui.icon('plus') }}</summary>
                    <ol class="admin-sortable admin-sortable--nested" data-sortable data-reorder-url="{{ path('app_admin_documents_reorder') }}" aria-label="Ordre des articles de « {{ cat.name }} »">
                        {% for doc in docs %}
                            <li class="admin-doc" data-id="{{ doc.id }}" draggable="true">
                                <span class="admin-sortable__handle" data-drag-handle title="Glisser pour déplacer">{{ ui.icon('grip') }}</span>
                                <span class="admin-sortable__pos num" data-position>{{ loop.index }}</span>
                                <a class="admin-doc__title" href="{{ path('app_admin_document_edit', {id: doc.id}) }}">{{ doc.title }}</a>
                                <span class="admin-doc__meta">
                                    {{ f.access_badge(doc.accessLevel) }}
                                    {% if not doc.isPublished %}{{ ui.badge('Brouillon', 'soon') }}{% endif %}
                                </span>
                                <span class="admin-module__actions">
                                    <button type="button" class="admin-icon-btn" data-move="up" aria-label="Monter « {{ doc.title }} »">{{ ui.icon('arrow-up') }}</button>
                                    <button type="button" class="admin-icon-btn" data-move="down" aria-label="Descendre « {{ doc.title }} »">{{ ui.icon('arrow-down') }}</button>
                                </span>
                            </li>
                        {% endfor %}
                    </ol>
                </details>
            {% endif %}
        </li>
    {% endfor %}
</ol>
{% endif %}
{% endblock %}
