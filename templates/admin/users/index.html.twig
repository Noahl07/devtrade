{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block admin_title %}Utilisateurs{% endblock %}
{% block admin_lead %}<p class="admin__lead">{{ users|length }} compte{{ users|length > 1 ? 's' }}. L'accès Premium se donne ou se retire ici, après paiement ou à la demande. La suppression d'un compte est définitive ; les comptes administrateurs et le vôtre ne peuvent pas être supprimés ici.</p>{% endblock %}

{% block admin_content %}
<p class="admin-online" aria-live="polite">
    <span class="admin-online__dot{{ online_members + online_visitors > 0 ? ' is-active' }}" aria-hidden="true"></span>
    {{ ui.badge(online_members ~ ' membre' ~ (online_members > 1 ? 's') ~ ' en ligne', online_members > 0 ? 'live' : 'backtest') }}
    {{ ui.badge(online_visitors ~ ' visiteur' ~ (online_visitors > 1 ? 's') ~ ' actif' ~ (online_visitors > 1 ? 's'), 'backtest') }}
    <span class="muted">sur les 5 dernières minutes, administrateurs exclus. Visiteurs : pages vues, connectés ou non, hors refus de suivi.</span>
</p>
{% if users is empty %}
    <p class="admin-empty">Aucun compte.</p>
{% else %}
<div class="table-wrap">
    <table class="data-table admin-table">
        <caption class="visually-hidden">Comptes, du plus récent au plus ancien</caption>
        <thead><tr><th scope="col">Nom</th><th scope="col">E-mail</th><th scope="col">Inscription</th><th scope="col">Activité</th><th scope="col">Rôle</th><th scope="col">Accès</th><th scope="col"><span class="visually-hidden">Supprimer</span></th></tr></thead>
        <tbody>
        {% for user in users %}
            <tr>
                <th scope="row">{{ user.fullName }}</th>
                <td class="admin-table__email">{{ user.email }}</td>
                <td class="num">{{ user.createdAt|date('d/m/Y') }}</td>
                <td>{% if user.online %}{{ ui.badge('En ligne', 'live') }}{% elseif user.lastSeenAt %}<span class="muted">{{ user.lastSeenAt|date('d/m/Y H:i') }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
                <td>{% if 'ROLE_ADMIN' in user.roles %}{{ ui.badge('Admin', 'demo') }}{% else %}<span class="muted">Membre</span>{% endif %}</td>
                <td>
                    <form method="post" action="{{ path('app_admin_user_toggle_premium', {id: user.id}) }}" class="admin-switch-form"
                          data-confirm="{{ user.isPremium ? 'Retirer l\'accès Premium à ' : 'Donner l\'accès Premium à ' }}{{ user.fullName }} ?">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle-premium-' ~ user.id) }}">
                        {{ user.isPremium ? ui.badge('Premium', 'demo') : ui.badge('Gratuit', 'backtest') }}
                        <button class="button button--ghost">{{ user.isPremium ? 'Retirer' : 'Passer Premium' }}</button>
                    </form>
                </td>
                <td>
                    {% if 'ROLE_ADMIN' not in user.roles and user != app.user %}
                    <form method="post" action="{{ path('app_admin_user_delete', {id: user.id}) }}"
                          data-confirm="Supprimer définitivement le compte de {{ user.fullName }} ({{ user.email }}) ? Cette action est irréversible.">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                        <button class="button button--ghost">Supprimer</button>
                    </form>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
