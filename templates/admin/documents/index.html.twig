{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import 'admin/_form.html.twig' as f %}

{% block admin_title %}Articles{% endblock %}
{% block admin_lead %}<p class="admin__lead">{{ total }} article{{ total > 1 ? 's' }}{% if filters|filter(v => v)|length %} correspondant{{ total > 1 ? 's' }} aux filtres{% endif %}.</p>{% endblock %}
{% block admin_actions %}{{ ui.button('Importer un lot', path('app_admin_documentation_import'), 'secondary', 'upload') }} {{ ui.button('Nouvel article', path('app_admin_document_new'), 'primary', 'plus') }}{% endblock %}

{% block admin_content %}
<form method="get" class="admin-filters" role="search" aria-label="Filtrer les articles">
    <div class="field admin-filters__search">
        <label class="field__label" for="q">Rechercher</label>
        <input class="input" id="q" name="q" type="search" value="{{ filters.q }}" placeholder="Titre ou adresse" maxlength="100">
    </div>
    <div class="field">
        <label class="field__label" for="category">Module</label>
        <select class="input" id="category" name="category" data-autosubmit>
            <option value="">Tous</option>
            {% for cat in categories %}<option value="{{ cat.id }}"{% if filters.category == cat.id %} selected{% endif %}>{{ cat.name }}</option>{% endfor %}
        </select>
    </div>
    <div class="field">
        <label class="field__label" for="access">Accès</label>
        <select class="input" id="access" name="access" data-autosubmit>
            <option value="">Tous</option>
            <option value="free"{% if filters.access == 'free' %} selected{% endif %}>Gratuit</option>
            <option value="premium"{% if filters.access == 'premium' %} selected{% endif %}>Premium</option>
        </select>
    </div>
    <div class="field">
        <label class="field__label" for="status">Statut</label>
        <select class="input" id="status" name="status" data-autosubmit>
            <option value="">Tous</option>
            <option value="published"{% if filters.status == 'published' %} selected{% endif %}>Publiés</option>
            <option value="draft"{% if filters.status == 'draft' %} selected{% endif %}>Brouillons</option>
        </select>
    </div>
    <div class="admin-filters__actions">
        <button class="button button--secondary" type="submit">{{ ui.icon('search') }} Filtrer</button>
        {% if filters|filter(v => v)|length %}<a class="button button--ghost" href="{{ path('app_admin_documents') }}">Réinitialiser</a>{% endif %}
    </div>
</form>

{% if documents is empty %}
    <p class="admin-empty">Aucun article ne correspond.</p>
{% else %}
<div class="table-wrap">
    <table class="data-table admin-table">
        <caption class="visually-hidden">Articles, du plus récent au plus ancien</caption>
        <thead>
            <tr><th scope="col">Titre</th><th scope="col">Module</th><th scope="col">État</th><th scope="col" class="num">Lecture</th><th scope="col">Créé le</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody>
        {% for doc in documents %}
            <tr>
                <th scope="row"><a class="admin-table__title" href="{{ path('app_admin_document_edit', {id: doc.id}) }}">{{ doc.title }}</a><small class="mono">{{ doc.slug }}</small></th>
                <td>{{ doc.category.name }}</td>
                <td><span class="admin-table__badges">{{ f.access_badge(doc.accessLevel) }}{{ doc.isPublished ? ui.badge('Publié', 'live') : ui.badge('Brouillon', 'soon') }}</span></td>
                <td class="num">{{ doc.readingTime ? doc.readingTime ~ ' min' : '—' }}</td>
                <td class="num">{{ doc.createdAt|date('d/m/Y') }}</td>
                <td>
                    <div class="admin-table__actions">
                        {% if doc.isPublished and doc.accessLevel in ['free', 'premium'] %}
                            <a class="admin-icon-btn" href="{{ path('app_documentation_article', {accessLevel: doc.accessLevel, slug: doc.slug}) }}" target="_blank" rel="noopener" aria-label="Voir « {{ doc.title }} » sur le site">{{ ui.icon('arrow-up-right') }}</a>
                        {% endif %}
                        <a class="admin-icon-btn" href="{{ path('app_admin_document_edit', {id: doc.id}) }}" aria-label="Modifier « {{ doc.title }} »">{{ ui.icon('edit') }}</a>
                        <form method="post" action="{{ path('app_admin_document_delete', {id: doc.id}) }}" data-confirm="Supprimer définitivement « {{ doc.title }} » ?">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-doc-' ~ doc.id) }}">
                            <button class="admin-icon-btn admin-icon-btn--danger" aria-label="Supprimer « {{ doc.title }} »">{{ ui.icon('trash') }}</button>
                        </form>
                    </div>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% if pages > 1 %}
    <nav class="admin-pager" aria-label="Pages">
        {% set query = filters|filter(v => v) %}
        {% if page > 1 %}<a class="button button--secondary" href="{{ path('app_admin_documents', query|merge({page: page - 1})) }}" rel="prev">{{ ui.icon('arrow-left') }} Précédente</a>{% endif %}
        <span class="num muted">Page {{ page }} / {{ pages }}</span>
        {% if page < pages %}<a class="button button--secondary" href="{{ path('app_admin_documents', query|merge({page: page + 1})) }}" rel="next">Suivante {{ ui.icon('arrow-right') }}</a>{% endif %}
    </nav>
{% endif %}
{% endif %}
{% endblock %}
