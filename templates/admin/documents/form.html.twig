{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}
{% import 'admin/_form.html.twig' as f %}

{% set isNew = document.id is null %}
{% set defaults = {
    title: document.title, slug: document.slug, category: document.category ? document.category.id : '',
    accessLevel: document.accessLevel, readingTime: document.readingTime, excerpt: document.excerpt,
    content: document.content, isPublished: document.isPublished,
} %}
{% set v = values is null ? defaults : defaults|merge(values) %}

{% block admin_title %}{{ isNew ? 'Nouvel article' : 'Modifier l\'article' }}{% endblock %}
{% block admin_breadcrumb %}<nav aria-label="Fil d'Ariane"><ol class="breadcrumb"><li><a href="{{ path('app_admin_documents') }}">Articles</a></li><li aria-current="page">{{ isNew ? 'Nouveau' : document.title }}</li></ol></nav>{% endblock %}
{% block admin_actions %}
    {% if not isNew and document.isPublished and document.accessLevel in ['free', 'premium'] %}
        <a class="button button--secondary" href="{{ path('app_documentation_article', {accessLevel: document.accessLevel, slug: document.slug}) }}" target="_blank" rel="noopener">Voir sur le site {{ ui.icon('arrow-up-right') }}</a>
    {% endif %}
{% endblock %}

{% block admin_content %}
<form method="post" class="admin-form admin-form--editor" data-dirty-guard novalidate>
    <input type="hidden" name="_token" value="{{ csrf_token('admin_form') }}">
    {{ f.summary(errors) }}

    <div class="admin-editor-layout">
        <div class="admin-editor-main">
            {{ f.input('title', 'Titre', v.title, errors, {required: true, maxlength: 200, attr: {'data-slug-source': ''}}) }}

            <div class="field field--wide">
                <div class="admin-editor__bar">
                    <label class="field__label" for="content">Contenu (HTML)</label>
                    <div class="admin-editor__tools" role="toolbar" aria-label="Mise en forme" aria-controls="content">
                        <button type="button" data-wrap="h2" title="Intertitre">H2</button>
                        <button type="button" data-wrap="h3" title="Sous-titre">H3</button>
                        <button type="button" data-wrap="p" title="Paragraphe">¶</button>
                        <button type="button" data-wrap="strong" title="Gras"><b>G</b></button>
                        <button type="button" data-wrap="em" title="Italique"><i>I</i></button>
                        <button type="button" data-wrap="code" title="Code">&lt;/&gt;</button>
                        <button type="button" data-block="ul" title="Liste">• —</button>
                        <button type="button" data-block="blockquote" title="Citation">«&nbsp;»</button>
                        <button type="button" data-block="pre" title="Bloc de code">{ }</button>
                        <button type="button" class="admin-editor__preview-btn" data-preview-toggle aria-pressed="false">{{ ui.icon('eye') }} Aperçu</button>
                    </div>
                </div>
                <textarea class="input admin-editor__area" id="content" name="content" rows="22" data-editor spellcheck="true"{{ f.describedby('content', errors, 'content-help') }}>{{ v.content }}</textarea>
                <div class="admin-editor__preview prose" data-preview hidden aria-live="polite"></div>
                <p class="field__help" id="content-help"><span data-word-count>0 mot</span> · Le HTML est nettoyé à l'affichage (scripts et attributs dangereux retirés). L'aperçu montre exactement ce que verront les lecteurs. <kbd>Ctrl</kbd>+<kbd>S</kbd> enregistre sans quitter la page.</p>
            </div>
        </div>

        <aside class="admin-editor-side">
            <div class="admin-panel">
                <h2 class="admin-panel__title">Publication</h2>
                {{ f.toggle('isPublished', 'Publié', (values is null ? defaults.isPublished : values.isPublished is defined), 'Visible dans la documentation.') }}
                {% if not isNew and document.publishedAt %}<p class="field__help">Publié le {{ document.publishedAt|date('d/m/Y') }}</p>{% endif %}
            </div>

            <div class="admin-panel admin-form__stack">
                <div class="field">
                    <label class="field__label" for="category">Module <span class="field__req" aria-hidden="true">*</span></label>
                    <select class="input" id="category" name="category" required{{ f.describedby('category', errors, null) }}>
                        <option value="">Choisir…</option>
                        {% for cat in categories %}<option value="{{ cat.id }}"{% if cat.id ~ '' == v.category ~ '' %} selected{% endif %}>{{ cat.name }}</option>{% endfor %}
                    </select>
                    {{ f.foot('category', errors, null) }}
                </div>
                {{ f.select('accessLevel', 'Accès', access_levels, v.accessLevel ?? 'free', errors) }}
                <div class="field">
                    <label class="field__label" for="readingTime">Temps de lecture (min)</label>
                    <div class="admin-inline">
                        <input class="input" id="readingTime" name="readingTime" type="number" min="1" max="240" value="{{ v.readingTime }}"{{ f.describedby('readingTime', errors, null) }}>
                        <button type="button" class="button button--ghost" data-reading-estimate title="Estimer à partir du contenu (200 mots par minute)">Estimer</button>
                    </div>
                    {{ f.foot('readingTime', errors, null) }}
                </div>
                {{ f.input('slug', 'Adresse (slug)', v.slug, errors, {mono: true, maxlength: 220, placeholder: 'générée depuis le titre', help: isNew ? 'Laissez vide pour la générer depuis le titre.' : 'Changer l\'adresse casse les liens existants.', attr: {'data-slug-target': ''}}) }}
                {{ f.textarea('excerpt', 'Extrait', v.excerpt, errors, {rows: 4, maxlength: 400, help: 'Résumé affiché dans la liste du module (400 caractères max).'}) }}
            </div>
        </aside>
    </div>

    <div class="admin-form__bar">
        {% if not isNew %}
            <button type="submit" form="delete-doc" class="button button--ghost admin-danger-link">{{ ui.icon('trash') }} Supprimer</button>
        {% endif %}
        <span class="admin-form__spacer"></span>
        {{ ui.button('Annuler', path('app_admin_documents'), 'ghost') }}
        <button type="submit" name="stay" value="1" class="button button--secondary" data-save-stay>Enregistrer et continuer</button>
        <button type="submit" class="button button--primary">{{ isNew ? 'Créer l\'article' : 'Enregistrer' }} {{ ui.icon('check') }}</button>
    </div>
</form>

{% if not isNew %}
    <form id="delete-doc" method="post" action="{{ path('app_admin_document_delete', {id: document.id}) }}" data-confirm="Supprimer définitivement « {{ document.title }} » ?">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-doc-' ~ document.id) }}">
    </form>
{% endif %}
{% endblock %}
