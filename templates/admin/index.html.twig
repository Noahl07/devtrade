{% extends 'admin/_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block admin_title %}Tableau de bord{% endblock %}
{% block admin_lead %}<p class="admin__lead">{{ 'now'|date('d/m/Y') }} · vue d'ensemble du site.</p>{% endblock %}
{% block admin_actions %}
    {{ ui.button('Nouvel article', path('app_admin_document_new'), 'primary', 'plus') }}
    {{ ui.button('Nouvelle réalisation', path('app_admin_project_new'), 'secondary', 'plus') }}
{% endblock %}

{% block admin_content %}
{% set tiles = [
    {value: stats.users, label: 'Utilisateurs', href: path('app_admin_users'), icon: 'users'},
    {value: stats.premium, label: 'Accès Premium', href: path('app_admin_users'), icon: 'shield'},
    {value: stats.documents, label: 'Articles publiés', href: path('app_admin_documents', {status: 'published'}), icon: 'book'},
    {value: stats.drafts, label: 'Brouillons', href: path('app_admin_documents', {status: 'draft'}), icon: 'edit'},
    {value: stats.waitlist, label: 'Liste d\'attente', href: path('app_admin_waitlist'), icon: 'mail'},
    {value: stats.projects, label: 'Réalisations visibles', href: path('app_admin_projects'), icon: 'grid'},
    {value: stats.trades_pending, label: 'Trades à valider', href: path('app_admin_community'), icon: 'chart'},
] %}
<ul class="admin-tiles">
    {% for t in tiles %}
        <li><a class="admin-tile" href="{{ t.href }}">
            <span class="admin-tile__icon">{{ ui.icon(t.icon) }}</span>
            <span class="admin-tile__value num">{{ t.value }}</span>
            <span class="admin-tile__label">{{ t.label }}</span>
        </a></li>
    {% endfor %}
</ul>

<div class="admin-grid">
    <section class="admin-panel" aria-labelledby="latest-users">
        <header class="admin-panel__head">
            <h2 id="latest-users">Derniers inscrits</h2>
            <a class="button button--ghost" href="{{ path('app_admin_users') }}">Tout voir {{ ui.icon('arrow-right') }}</a>
        </header>
        {% if latest_users is empty %}
            <p class="admin-empty">Aucun inscrit pour l'instant.</p>
        {% else %}
            <ul class="admin-rows">
                {% for user in latest_users %}
                    <li>
                        <span><strong>{{ user.fullName }}</strong><small>{{ user.email }}</small></span>
                        <span class="admin-rows__meta">{% if user.isPremium %}{{ ui.badge('Premium', 'demo') }}{% endif %}<time class="num">{{ user.createdAt|date('d/m/Y') }}</time></span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="admin-panel" aria-labelledby="latest-waitlist">
        <header class="admin-panel__head">
            <h2 id="latest-waitlist">Liste d'attente</h2>
            <a class="button button--ghost" href="{{ path('app_admin_waitlist') }}">Tout voir {{ ui.icon('arrow-right') }}</a>
        </header>
        {% if latest_waitlist is empty %}
            <p class="admin-empty">Personne n'est encore inscrit.</p>
        {% else %}
            <ul class="admin-rows">
                {% for entry in latest_waitlist %}
                    <li>
                        <span><strong>{{ entry.email }}</strong><small>{{ entry.source }}</small></span>
                        <span class="admin-rows__meta"><time class="num">{{ entry.createdAt|date('d/m/Y') }}</time></span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
