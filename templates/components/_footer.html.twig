{% import 'components/ui/_ui.html.twig' as ui %}

<footer class="site-footer">
    <div class="container">
        <div class="grid-12 site-footer__top">
            <div class="span-4">
                <a class="brand" href="{{ path('app_home') }}">dev<span class="brand__dot">.</span>trade</a>
                <p class="site-footer__tagline">Développement fullstack et trading algorithmique.</p>
                <span class="site-footer__email">{{ contact_email }}</span>
            </div>

            <nav class="span-8 site-footer__cols" aria-label="Pied de page">
                <div>
                    <span class="site-footer__title">Développement</span>
                    <ul>
                        <li><a href="{{ path('app_portfolio') }}">Réalisations</a></li>
                        <li><a href="{{ path('app_contact') }}">Démarrer un projet</a></li>
                    </ul>
                </div>
                <div>
                    <span class="site-footer__title">Trading</span>
                    <ul>
                        <li><a href="{{ path('app_trading') }}">{{ product_name }}</a></li>
                        <li><a href="{{ path('app_documentation') }}">Documentation</a></li>
                        <li><a href="{{ path('app_pricing') }}">Accès Premium</a></li>
                    </ul>
                </div>
                <div>
                    <span class="site-footer__title">Compte</span>
                    <ul>
                        {% if app.user %}
                            <li><a href="{{ path('app_compte') }}">Mon espace</a></li>
                            <li><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                        {% else %}
                            <li><a href="{{ path('app_login') }}">Connexion</a></li>
                            <li><a href="{{ path('app_register') }}">Créer un compte</a></li>
                        {% endif %}
                    </ul>
                </div>
                <div>
                    <span class="site-footer__title">Informations</span>
                    <ul>
                        <li><a href="{{ path('app_cgu') }}">Conditions d'utilisation</a></li>
                        <li><a href="{{ path('app_contact') }}">Contact</a></li>
                        {# TODO (PROMPT-REFONTE §2.6) : mentions légales, politique de confidentialité,
                           CGV et page « Risques et limites », à créer puis faire valider. #}
                    </ul>
                </div>
            </nav>
        </div>

        {# Avertissement de risque présent sur toutes les pages (§2.5) #}
        {{ ui.risk_notice() }}

        <div class="site-footer__bottom">
            <span>© {{ 'now'|date('Y') }} dev.trade</span>
            <span>Aucun conseil en investissement. Aucun résultat réel vérifié à ce jour.</span>
        </div>
    </div>
</footer>
