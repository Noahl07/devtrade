{# Composants d'interface du design system (macros Twig).
   Usage : {% import 'components/ui/_ui.html.twig' as ui %} puis {{ ui.button(...) }}.
   Couleurs et tailles : uniquement via assets/styles/ds/. #}

{# ── Icônes SVG (dessinées pour le projet, trait 24×24) ── #}
{% macro icon(name, label = null) %}
    {%- set paths = {
        'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
        'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
        'check': '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
        'plus': '<path d="M12 5v14M5 12h14"/>',
        'close': '<path d="M6 6l12 12M18 6 6 18"/>',
        'menu': '<path d="M4 7h16M4 12h16M4 17h16"/>',
        'alert': '<path d="M12 3.5 2.5 20h19L12 3.5Z"/><path d="M12 10v4.5M12 17.2v.1"/>',
        'info': '<circle cx="12" cy="12" r="9"/><path d="M12 11v5.5M12 7.8v.1"/>',
        'clock': '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.2 2"/>',
        'chart': '<path d="M3.5 3.5v17h17"/><path d="m7.5 14.5 3.5-4 3 3 5-6.5"/>',
        'shield': '<path d="M12 3 19.5 6v5.6c0 4.6-3.2 8.2-7.5 9.4-4.3-1.2-7.5-4.8-7.5-9.4V6L12 3Z"/>',
        'lock': '<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>',
        'mail': '<rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
        'code': '<path d="m8.5 7-5 5 5 5M15.5 7l5 5-5 5"/>',
        'book': '<path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 1 4 18.5v-13ZM13 4h5.5A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5H13V4Z"/>',
        'calendar': '<rect x="3.5" y="5" width="17" height="15.5" rx="1.5"/><path d="M3.5 9.5h17M8 3v4M16 3v4"/>',
        'download': '<path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/>',
    } -%}
    <svg class="icon" viewBox="0 0 24 24" width="20" height="20" {% if label %}role="img" aria-label="{{ label }}"{% else %}aria-hidden="true" focusable="false"{% endif %}>
        {{- paths[name]|default('')|raw -}}
        {# |raw justifié : chaînes SVG statiques définies ci-dessus, aucune donnée externe. #}
    </svg>
{%- endmacro %}

{# ── Bouton ou lien-bouton ── #}
{% macro button(label, href = null, variant = 'primary', icon = null, type = 'button') %}
    {%- import _self as ui -%}
    {%- if href -%}
        <a class="button button--{{ variant }}" href="{{ href }}">{{ label }}{% if icon %}{{ ui.icon(icon) }}{% endif %}</a>
    {%- else -%}
        <button class="button button--{{ variant }}" type="{{ type }}">{{ label }}{% if icon %}{{ ui.icon(icon) }}{% endif %}</button>
    {%- endif -%}
{% endmacro %}

{# ── Badge d'état : demo | backtest | soon | live ── #}
{% macro badge(label, kind = 'backtest') %}
    <span class="badge badge--{{ kind }}">{{ label }}</span>
{% endmacro %}

{# ── Chiffre de performance : le contexte est OBLIGATOIRE (PROMPT-REFONTE §2.2).
   Sans contexte, rien n'est affiché. ── #}
{% macro figure(value, label, context) %}
    {%- if context is not empty -%}
        <div class="figure">
            <span class="figure__value">{{ value }}</span>
            <span class="figure__label">{{ label }}</span>
            <span class="figure__context">{{ context }}</span>
        </div>
    {%- endif -%}
{% endmacro %}

{# ── Avertissement : info | risk ── #}
{% macro notice(content, kind = 'info', title = null) %}
    {%- import _self as ui -%}
    <div class="notice notice--{{ kind }}" {% if kind == 'risk' %}role="note"{% endif %}>
        {{ ui.icon(kind == 'risk' ? 'alert' : 'info') }}
        <p>{% if title %}<strong>{{ title }}</strong> {% endif %}{{ content }}</p>
    </div>
{% endmacro %}

{# ── Avertissement de risque standard (§2.5), texte unique pour tout le site ── #}
{% macro risk_notice() %}
    {%- import _self as ui -%}
    {{ ui.notice("Le trading de CFD et de Forex comporte un risque élevé de perte en capital. Les performances passées, y compris en simulation, ne préjugent pas des performances futures. Ce site ne fournit ni conseil en investissement ni recommandation personnalisée.", 'risk', 'Risque de perte en capital.') }}
{% endmacro %}
