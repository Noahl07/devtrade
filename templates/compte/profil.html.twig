{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Modifier mon profil{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{# Page refondue (Phase 5). #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% macro error(errors, field) %}
    {%- if errors[field] is defined %}<p class="field__error" id="{{ field }}-error">{{ errors[field] }}</p>{% endif -%}
{% endmacro %}
{% macro invalid(errors, field) %}
    {%- if errors[field] is defined %} aria-invalid="true" aria-describedby="{{ field }}-error"{% endif -%}
{% endmacro %}

{% block body %}
{% import _self as f %}
<header class="page-hero">
    <div class="container">
        <nav aria-label="Fil d'Ariane"><ol class="breadcrumb"><li><a href="{{ path('app_compte') }}">Mon compte</a></li><li aria-current="page">Profil</li></ol></nav>
        <h1>Votre <em>profil.</em></h1>
    </div>
</header>

<section class="section">
    <div class="container account account--form">
        <aside class="account__card account__identity">
            <span class="account__avatar" aria-hidden="true">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</span>
            <strong>{{ user.firstName }} {{ user.lastName }}</strong>
            <span class="muted small">{{ user.email }}</span>
            <span class="muted small">Membre depuis {{ user.createdAt|date('m/Y') }}</span>
            {% if user.isPremium %}{{ ui.badge('Accès Premium', 'live') }}{% else %}{{ ui.badge('Compte gratuit', 'backtest') }}{% endif %}
        </aside>

        <form method="post" class="account__card auth-form" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('profil') }}">

            {% if errors|length > 0 %}
                {{ ui.notice('Corrigez les champs signalés.', 'risk', 'Rien n\'a été enregistré.') }}
            {% endif %}

            <fieldset class="account__fieldset">
                <legend class="eyebrow">Informations personnelles</legend>
                <div class="auth-form__row">
                    <div class="field">
                        <label class="field__label" for="firstName">Prénom</label>
                        <input class="input" id="firstName" name="firstName" type="text" autocomplete="given-name" minlength="2" maxlength="80" required value="{{ values.firstName }}"{{ f.invalid(errors, 'firstName') }}>
                        {{ f.error(errors, 'firstName') }}
                    </div>
                    <div class="field">
                        <label class="field__label" for="lastName">Nom</label>
                        <input class="input" id="lastName" name="lastName" type="text" autocomplete="family-name" minlength="2" maxlength="80" required value="{{ values.lastName }}"{{ f.invalid(errors, 'lastName') }}>
                        {{ f.error(errors, 'lastName') }}
                    </div>
                </div>
                <div class="field">
                    <label class="field__label" for="email">E-mail</label>
                    <input class="input" id="email" type="email" autocomplete="username" value="{{ user.email }}" disabled aria-describedby="email-help">
                    <p class="field__help" id="email-help">L'adresse e-mail ne peut pas être modifiée ici. Écrivez-nous si besoin.</p>
                </div>
            </fieldset>

            <fieldset class="account__fieldset">
                <legend class="eyebrow">Mot de passe</legend>
                <p class="field__help">Laissez ces champs vides pour garder le mot de passe actuel.</p>
                <div class="field">
                    <label class="field__label" for="currentPassword">Mot de passe actuel</label>
                    <input class="input" id="currentPassword" name="currentPassword" type="password" autocomplete="current-password" maxlength="4096"{{ f.invalid(errors, 'currentPassword') }}>
                    {{ f.error(errors, 'currentPassword') }}
                </div>
                <div class="auth-form__row">
                    <div class="field">
                        <label class="field__label" for="newPassword">Nouveau mot de passe</label>
                        <div class="password">
                            <input class="input" id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128"{{ f.invalid(errors, 'newPassword') }}>
                            <button class="password__toggle" type="button" data-password-toggle aria-pressed="false" aria-label="Afficher le mot de passe">{{ ui.icon('eye') }}</button>
                        </div>
                        {{ f.error(errors, 'newPassword') }}
                    </div>
                    <div class="field">
                        <label class="field__label" for="confirmPassword">Confirmer</label>
                        <input class="input" id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="128"{{ f.invalid(errors, 'confirmPassword') }}>
                        {{ f.error(errors, 'confirmPassword') }}
                    </div>
                </div>
            </fieldset>

            <div class="account__actions account__actions--end">
                {{ ui.button('Annuler', path('app_compte'), 'ghost') }}
                <button type="submit" class="button button--primary">Enregistrer {{ ui.icon('arrow-right') }}</button>
            </div>
        </form>
    </div>
</section>
{% endblock %}
