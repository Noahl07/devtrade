{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Mon compte{% endblock %}
{% block meta_robots %}noindex, nofollow{% endblock %}

{# Page refondue (Phase 5). #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}
<header class="page-hero">
    <div class="container page-hero__grid">
        <div>
            <span class="eyebrow">Espace membre</span>
            <h1>Bonjour, <em>{{ user.firstName }}.</em></h1>
            <p class="lead">Votre accès, vos lectures et vos informations, au même endroit.</p>
        </div>
        <div class="page-hero__meta">
            {% if user.isPremium %}{{ ui.badge('Accès Premium', 'live') }}{% else %}{{ ui.badge('Compte gratuit', 'backtest') }}{% endif %}
        </div>
    </div>
</header>

<section class="section">
    <div class="container account">
        <article class="account__card account__card--wide">
            <span class="account__index">{{ ui.icon('book') }} Documentation</span>
            {% if user.isPremium %}
                <h2>Tous les modules vous sont ouverts.</h2>
                <p>Votre accès Premium couvre les modules gratuits et avancés, au fil de leur publication.</p>
            {% else %}
                <h2>Les modules gratuits vous sont ouverts.</h2>
                <p>Les modules avancés sont réservés à l'accès Premium. Rien ne presse : les bases sont déjà là.</p>
            {% endif %}
            <div class="account__actions">
                {{ ui.button('Ouvrir la documentation', path('app_documentation'), 'primary', 'arrow-right') }}
                {% if not user.isPremium %}{{ ui.button('Voir l\'accès Premium', path('app_pricing'), 'ghost', 'arrow-right') }}{% endif %}
                {% if user.stripeCustomerId %}
                    <form method="post" action="{{ path('app_billing_portal') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('billing-portal') }}">
                        {{ ui.button('Gérer mon abonnement', null, 'ghost', 'arrow-up-right', 'submit') }}
                    </form>
                {% endif %}
            </div>
            {% if user.stripeCustomerId %}<p class="muted small">Factures, carte bancaire et résiliation se gèrent sur l'espace sécurisé de Stripe.</p>{% endif %}
        </article>

        <article class="account__card">
            <span class="account__index">{{ ui.icon('users') }} Salle des trades</span>
            <h2>Partagez vos trades, apprenez de ceux des autres.</h2>
            <p>Une à trois captures, le contexte et ce que vous en retenez. Gains et pertes sont les bienvenus.</p>
            <div class="account__actions">
                {{ ui.button('Ouvrir la salle des trades', path('app_community'), 'secondary', 'arrow-right') }}
                {{ ui.button('Mes publications', path('app_community_mine'), 'ghost') }}
            </div>
        </article>

        <article class="account__card">
            <span class="account__index">{{ ui.icon('chart') }} {{ product_name }}</span>
            <h2>Le robot n'est pas encore disponible.</h2>
            <p>Il tourne en démonstration. La liste d'attente vous préviendra de sa sortie, sans engagement.</p>
            <div class="account__actions">
                {{ ui.button('Découvrir ' ~ product_name, path('app_trading') ~ '#liste-attente', 'ghost', 'arrow-right') }}
            </div>
        </article>

        <article class="account__card">
            <span class="account__index">{{ ui.icon('shield') }} Profil</span>
            <dl class="account__facts">
                <div><dt>Nom</dt><dd>{{ user.firstName }} {{ user.lastName }}</dd></div>
                <div><dt>E-mail</dt><dd>{{ user.email }}</dd></div>
                <div><dt>Membre depuis</dt><dd class="num">{{ user.createdAt|date('d/m/Y') }}</dd></div>
            </dl>
            <div class="account__actions">
                {{ ui.button('Modifier le profil', path('app_compte_profil'), 'secondary') }}
            </div>
        </article>
    </div>
</section>
{% endblock %}
