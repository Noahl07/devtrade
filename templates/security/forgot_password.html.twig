{% extends 'security/_auth_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Mot de passe oublié{% endblock %}

{% block auth_card %}
    <span class="eyebrow">Mot de passe oublié</span>
    <h1>Réinitialiser.</h1>

    {% if success %}
        {# Message identique que l'adresse existe ou non (pas d'énumération). #}
        <div class="form-alert">{{ ui.notice("Si un compte existe pour cette adresse, un lien de réinitialisation vient d'être envoyé. Il est valable une heure.", 'info', 'Vérifiez votre boîte mail.') }}</div>
    {% else %}
        <p>Indiquez votre adresse : vous recevrez un lien pour choisir un nouveau mot de passe.</p>
        {% if error %}<div class="form-alert">{{ ui.notice(error, 'risk') }}</div>{% endif %}

        <form method="post" class="auth-form">
            <input type="hidden" name="_token" value="{{ csrf_token('forgot') }}">
            <div class="field">
                <label class="field__label" for="email">Adresse e-mail</label>
                <input class="input" type="email" id="email" name="email" autocomplete="email" required autofocus>
            </div>
            <button type="submit" class="button button--primary auth-form__submit">Envoyer le lien {{ ui.icon('arrow-right') }}</button>
        </form>
    {% endif %}

    <p class="auth__alt"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
