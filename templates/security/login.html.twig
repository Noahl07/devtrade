{% extends 'security/_auth_layout.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Connexion{% endblock %}

{% block auth_card %}
    <span class="eyebrow">Connexion</span>
    <h1>Bon retour.</h1>
    <p>Connectez-vous pour accéder à la documentation.</p>

    {% if error %}
        {# Message générique : ne révèle pas si l'adresse existe (sauf le blocage temporaire, utile à l'utilisateur). #}
        {% if 'Too many' in error.messageKey %}
            <div class="form-alert">{{ ui.notice('Trop de tentatives. Réessayez dans quelques minutes.', 'risk') }}</div>
        {% else %}
            <div class="form-alert">{{ ui.notice('Identifiants incorrects. Vérifiez votre adresse e-mail et votre mot de passe.', 'risk') }}</div>
        {% endif %}
    {% endif %}

    <form method="post" class="auth-form">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <div class="field">
            <label class="field__label" for="username">Adresse e-mail</label>
            <input class="input" type="email" id="username" name="_username" value="{{ last_username }}" autocomplete="email" required autofocus>
        </div>

        <div class="field">
            <div class="auth-form__inline">
                <label class="field__label" for="password">Mot de passe</label>
                <a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a>
            </div>
            <div class="password">
                <input class="input" type="password" id="password" name="_password" autocomplete="current-password" required>
                <button class="password__toggle" type="button" data-password-toggle aria-pressed="false" aria-label="Afficher le mot de passe">{{ ui.icon('eye') }}</button>
            </div>
        </div>

        <label class="checkbox">
            <input type="checkbox" name="_remember_me">
            <span>Rester connecté sur cet appareil</span>
        </label>

        <button type="submit" class="button button--primary auth-form__submit">Se connecter {{ ui.icon('arrow-right') }}</button>
    </form>

    <p class="auth__alt">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte gratuit</a></p>
{% endblock %}
