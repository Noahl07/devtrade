{% extends 'base.html.twig' %}
{% import 'components/ui/_ui.html.twig' as ui %}

{% block title %}Contact{% endblock %}
{% block meta_description %}Un projet de développement, une question sur Shiro ou sur la documentation : écrivez-nous, vous recevrez une réponse personnelle.{% endblock %}

{# Page refondue (Phase 4) #}
{% block legacy_assets %}{% endblock %}
{% block legacy_scripts %}{% endblock %}

{% block body %}
<div class="container contact">
    <div>
        <span class="eyebrow">Contact</span>
        <h1 class="closing__title">Parlons de <em>votre projet.</em></h1>
        <p class="lead">Développement sur mesure, question sur {{ product_name }} ou sur l'accès Premium : vous recevrez une réponse personnelle.</p>

        <ul class="contact__facts">
            <li>{{ ui.icon('mail') }}<div><span>E-mail</span><span class="num">{{ contact_email }}</span></div></li>
            <li>{{ ui.icon('clock') }}<div><span>Délai de réponse</span>Sous 24 heures</div></li>
            <li>{{ ui.icon('code') }}<div><span>Disponibilité</span>France, en télétravail</div></li>
        </ul>
    </div>

    <div class="contact__card">
        {% if success %}
            <div class="contact__success" role="status">
                {{ ui.icon('check') }}
                <h2>Message envoyé.</h2>
                <p class="muted">Merci. Vous recevrez une réponse à l'adresse indiquée.</p>
                <div>{{ ui.button('Retour à l\'accueil', path('app_home'), 'ghost', 'arrow-right') }}</div>
            </div>
        {% else %}
            {% if error %}<div class="form-alert">{{ ui.notice(error, 'risk') }}</div>{% endif %}

            <form method="post" class="auth-form" novalidate>
                <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
                <div class="auth-form__row">
                    <div class="field">
                        <label class="field__label" for="c-name">Nom</label>
                        <input class="input" id="c-name" name="name" type="text" required maxlength="100" autocomplete="name" value="{{ values.name ?? '' }}">
                    </div>
                    <div class="field">
                        <label class="field__label" for="c-email">Adresse e-mail</label>
                        <input class="input" id="c-email" name="email" type="email" required autocomplete="email" value="{{ values.email ?? '' }}">
                    </div>
                </div>
                <div class="field">
                    <label class="field__label" for="c-subject">Sujet <span class="muted">(facultatif)</span></label>
                    <select class="input" id="c-subject" name="subject">
                        <option value="">Choisir un sujet</option>
                        {% for subject in subjects %}
                            <option {% if (values.subject ?? '') == subject %}selected{% endif %}>{{ subject }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="field">
                    <label class="field__label" for="c-message">Message</label>
                    <textarea class="input" id="c-message" name="message" required maxlength="5000" rows="7" placeholder="Décrivez votre projet ou votre question.">{{ values.message ?? '' }}</textarea>
                </div>
                <div class="hp-field" aria-hidden="true">
                    <label for="c-website">Ne pas remplir</label>
                    <input id="c-website" name="website" type="text" tabindex="-1" autocomplete="off">
                </div>
                <p class="field__help">Votre message est transmis par e-mail et n'est pas conservé sur le site.
                    Voir la <a href="{{ path('app_privacy') }}">politique de confidentialité</a>.</p>
                <button type="submit" class="button button--primary auth-form__submit">Envoyer le message {{ ui.icon('arrow-right') }}</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
